---
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import SkipLink from '../components/site/SkipLink.astro';
import '../styles/global.css';

import { getAlternatePaths, toLangPath, normalizePathname } from "../i18n/routes";

export interface Props {
	title: string;
	description?: string;
	lang?: "en" | "es";
	canonicalPath?: string;
}

const { title, description, lang = "en", canonicalPath } = Astro.props;

// Routing convention:
// - English is the default at `/...`
// - Spanish lives at `/es/...`
// This file uses a shared mapping helper so nested pages can follow the same rule.
const sourcePath = normalizePathname(canonicalPath ?? Astro.url.pathname);
const canonicalPathFinal = toLangPath(sourcePath, lang);
const alternates = getAlternatePaths(sourcePath);

const toHref = (path: string) => {
	const safePath = normalizePathname(path);
	const base = Astro.site instanceof URL ? Astro.site : new URL(Astro.url.origin);
	try {
		return new URL(safePath, base).toString();
	} catch {
		return new URL("/", base).toString();
	}
};

const canonicalHref = toHref(canonicalPathFinal);
const enHref = toHref(alternates.en);
const esHref = toHref(alternates.es);
const xDefaultHref = toHref(alternates.xDefault);
---

<!doctype html>
<html lang={lang} data-theme="light">
	<head>
		<meta charset="utf-8" />
		<script
			is:inline
			define:vars={{
				currentLang: lang,
				enPath: alternates.en,
				esPath: alternates.es,
			}}
		>
			(() => {
				// Runs early to avoid visible flash/layout shift.
				// Redirect based on: 1) explicit user preference, or 2) browser language for first-time visitors.
				try {
					const preferred = localStorage.getItem('preferredLang');
					
					// If user has explicitly chosen a language, respect that choice
					if (preferred === 'en' || preferred === 'es') {
						if (preferred !== currentLang) {
							const targetPath = preferred === 'es' ? esPath : enPath;
							const next = `${targetPath}${window.location.search}${window.location.hash}`;
							window.location.replace(next);
						}
						return;
					}

					// First-time visitor: check browser language preference
					// Only redirect if browser prefers Spanish and we're on English page
					const browserLang = navigator.language || navigator.userLanguage || '';
					const prefersSpanish = browserLang.toLowerCase().startsWith('es');
					
					if (prefersSpanish && currentLang === 'en') {
						// Mark as auto-detected so we don't keep redirecting
						// (user can override by clicking English in settings)
						localStorage.setItem('preferredLang', 'es');
						const next = `${esPath}${window.location.search}${window.location.hash}`;
						window.location.replace(next);
					}
				} catch {
					// ignore
				}
			})();
		</script>
		<script>
			import { initTheme } from "../lib/theme";

			globalThis.__astrid_themeInitController?.abort?.();
			const controller = new AbortController();
			globalThis.__astrid_themeInitController = controller;
			const { signal } = controller;

			document.addEventListener("astro:before-swap", () => controller.abort(), { once: true, signal });

			const run = () => initTheme();
			run();
			document.addEventListener("astro:page-load", run, { signal });
		</script>
		<script is:inline>
			(() => {
				// Progressive enhancement: only enable reveal styles when JS is running.
				// Skip entirely for reduced-motion users.
				try {
					const reduce = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
					if (reduce) return;
					document.documentElement.classList.add('has-scroll-reveal');
				} catch {
					// ignore
				}
			})();
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="preload"
			as="style"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
		/>
		<script is:inline>
			(() => {
				try {
					const href =
						"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap";
					const link = document.createElement("link");
					link.rel = "stylesheet";
					link.href = href;
					document.head.append(link);
				} catch {
					// ignore
				}
			})();
		</script>
		<noscript>
			<link
				rel="stylesheet"
				href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
			/>
		</noscript>
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" href="/favicon-light.ico" media="(prefers-color-scheme: light)" sizes="any" />
		<link rel="icon" href="/favicon-dark.ico" media="(prefers-color-scheme: dark)" sizes="any" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		{description ? <meta name="description" content={description} /> : null}
		<link rel="canonical" href={canonicalHref} />
		<link rel="alternate" hreflang="en" href={enHref} />
		<link rel="alternate" hreflang="es" href={esHref} />
		<link rel="alternate" hreflang="x-default" href={xDefaultHref} />
		<slot name="head" />
		<title>{title}</title>
	</head>
	<body id="top">
		<SkipLink lang={lang} />

		<Header lang={lang} />

		<main id="main-content" tabindex="-1">
			<slot />
		</main>

		<Footer lang={lang} />

		<script>
			import { initScrollReveal } from "../lib/scrollReveal";
			const schedule = () => {
				if (typeof window === "undefined") return;
				type IdleDeadline = {
					didTimeout: boolean;
					timeRemaining: () => number;
				};
				type RequestIdleCallback = (
					callback: (deadline: IdleDeadline) => void,
					options?: { timeout?: number },
				) => number;
				const requestIdleCallback = (window as Window & {
					requestIdleCallback?: RequestIdleCallback;
				}).requestIdleCallback;
				if (typeof requestIdleCallback === "function") {
					requestIdleCallback(() => initScrollReveal());
					return;
				}
				setTimeout(() => initScrollReveal(), 1);
			};
			schedule();
			window.addEventListener("scroll-reveal:refresh", schedule);
			document.addEventListener("astro:page-load", schedule);
		</script>
	</body>
</html>
