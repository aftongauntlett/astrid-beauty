---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Accordion from '../components/ui/Accordion.astro';
import SectionIntro from '../components/ui/SectionIntro.astro';
import FeatureIconCard from '../components/FeatureIconCard.astro';
import Gallery from '../components/Gallery.astro';
---

<BaseLayout title="Site" description="Placeholder homepage layout">
	<section class="section hero" aria-labelledby="page-title">
		<div class="container hero__grid">
			<div class="hero__content">
				<h1 class="sr-only" id="page-title">By Astrid Beauty</h1>
				<div class="hero__brandmark" aria-hidden="true">
					<img
						class="hero__brandmarkLogo"
						src="/by-astrid-beauty-logo.png"
						alt=""
						width="801"
						height="692"
						decoding="async"
					/>
				</div>
			</div>

			<div class="hero__actions" aria-label="Primary actions">
				<div class="hero__actionsCopy">
					<h2 class="hero__actionsTitle">Ready when you are</h2>
					<p class="hero__actionsLede">
						Placeholder copy for booking and services. Short, confident, and salon-appropriate.
					</p>
				</div>
				<div class="hero__actionsRow">
					<Button href="/#contact" variant="primary" size="lg">Schedule Appointment</Button>
					<Button href="/#services" variant="secondary" size="lg">View Services</Button>
				</div>
			</div>
		</div>
	</section>

	<section class="section" id="services" aria-labelledby="services-title">
		<div class="container stack stack--lg">
			<SectionIntro
				id="services-title"
				title="Services"
				lede="Placeholder section for services, using consistent gutters and spacing."
			/>

			<div class="narrow stack stack--lg">
				<FeatureIconCard
					title="Fancy icon card"
					description="Opt-in React island with motion, only loaded when visible."
					items={["Hover sparkle", "Respects reduced motion", "Token-based color"]}
					iconName="sparkles"
					iconColor="var(--color-primary)"
				/>

				<FeatureIconCard
					title="Fancy icon card (variant)"
					description="Same hover effects, calmer tone via tokens."
					items={["Client:visible", "No motion when reduced", "Accessible SVG"]}
					iconName="shield"
					iconColor="var(--color-text-muted)"
				/>
			</div>
		</div>
	</section>

	<section class="section" id="about" aria-labelledby="about-title">
		<div class="container stack stack--lg">
			<SectionIntro id="about-title" title="About" lede="Placeholder section for about information." />

			<div class="narrow">
				<Accordion
					items={[
						{ id: 'about-1', title: 'What we do', content: 'Placeholder accordion content.', iconName: 'sparkles' },
						{ id: 'about-2', title: 'How to book', content: 'Placeholder accordion content.', iconName: 'shield' },
						{ id: 'about-3', title: 'Accessibility', content: 'Placeholder accordion content.', iconName: 'sparkles' },
					]}
				/>
			</div>
		</div>
	</section>

	<section class="section" id="gallery" aria-labelledby="gallery-title">
		<div class="container stack">
			<SectionIntro
				id="gallery-title"
				title="Gallery"
				lede="A curated set of recent looks. Use “Show more” to view the full set."
			/>
			<Gallery />
		</div>
	</section>

	<section class="section" id="contact" aria-labelledby="contact-title">
		<div class="container stack stack--lg">
			<SectionIntro
				id="contact-title"
				title="Contact"
				lede="Placeholder section for contact information."
			/>

			<div class="back-to-top">
				<Button href="#top" variant="ghost">Back to top</Button>
			</div>
		</div>
	</section>
</BaseLayout>
