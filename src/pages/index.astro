---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import SectionIntro from '../components/ui/SectionIntro.astro';
import FeatureIconCard from '../components/FeatureIconCard.astro';
import Gallery from '../components/Gallery.astro';
---

<BaseLayout title="Site" description="Placeholder homepage layout">
	<section class="section hero" aria-labelledby="page-title">
		<div class="container hero__grid">
			<div class="hero__content">
				<p class="sr-only">By Astrid Beauty</p>
				<div class="hero__brandmark" aria-hidden="true">
					<img
						class="hero__brandmarkLogo"
						src="/by-astrid-beauty-logo.png"
						alt=""
						width="801"
						height="692"
						decoding="async"
					/>
				</div>
			</div>

			<div class="hero__actions" aria-label="Primary actions">
				<div class="hero__actionsCopy">
					<h1 class="hero__actionsTitle" id="page-title">Ready when you are</h1>
					<p class="hero__actionsLede">
						Placeholder copy for booking and services. Short, confident, and salon-appropriate.
					</p>
				</div>
				<div class="hero__actionsRow">
					<Button href="/#contact" variant="primary" size="lg">Schedule Appointment</Button>
					<Button href="/#services" variant="secondary" size="lg">View Services</Button>
				</div>
			</div>
		</div>
	</section>

	<section class="section" id="services" aria-labelledby="services-title">
		<div class="container stack stack--lg">
			<SectionIntro
				id="services-title"
				title="Services"
				lede="Placeholder section for services, using consistent gutters and spacing."
			/>

			<div class="services-grid" aria-label="Service highlights">
				<FeatureIconCard
					title="Signature Color"
					description="Dimensional color placed with a soft, natural finish."
					items={["Consult-first", "Gloss + tone", "Low-contrast grow-out"]}
					iconName="palette"
					iconColor="var(--color-primary)"
				/>

				<FeatureIconCard
					title="Cut + Style"
					description="Tailored shape, airy movement, and an easy everyday routine."
					items={["Face-framing", "Blowout finish", "At-home tips"]}
					iconName="scissors"
					iconColor="var(--color-text-muted)"
				/>

				<FeatureIconCard
					title="Gloss + Shine"
					description="A sheer refresh that brings softness and light back in."
					items={["Warm or cool", "Adds brightness", "No harsh tone"]}
					iconName="droplet"
					iconColor="var(--color-secondary)"
				/>

				<FeatureIconCard
					title="Scalp Care"
					description="Comfort-focused care for balance, hydration, and calm."
					items={["Gentle cleanse", "Massage", "Sensitive-safe"]}
					iconName="waves"
					iconColor="var(--color-primary)"
				/>
			</div>
		</div>
	</section>

	<style>
		.services-grid {
			display: grid;
			gap: var(--space-xl);
			grid-template-columns: 1fr;
			align-items: stretch;
		}

		@media (min-width: 48rem) {
			.services-grid {
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: calc(var(--space-xl) + var(--space-sm));
			}
		}
	</style>

	<section class="section" id="gallery" aria-labelledby="gallery-title">
		<div class="container stack">
			<SectionIntro
				id="gallery-title"
				title="Gallery"
				lede="A curated set of recent looks. Use “Show more” to view the full set."
			/>
			<Gallery />
		</div>
	</section>

	<section class="section" id="contact" aria-labelledby="contact-title">
		<div class="container stack stack--lg">
			<SectionIntro
				id="contact-title"
				title="Contact"
				lede="Placeholder section for contact information."
			/>

			<div class="back-to-top">
				<Button href="#top" variant="ghost">Back to top</Button>
			</div>
		</div>
	</section>
</BaseLayout>
