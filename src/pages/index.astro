---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Accordion from '../components/ui/Accordion.astro';
import SectionIntro from '../components/ui/SectionIntro.astro';
import FeatureIconCard from '../components/FeatureIconCard.astro';
---

<BaseLayout title="Site" description="Placeholder homepage layout">
	<section class="section hero" aria-labelledby="page-title">
		<div class="container hero__inner">
			<SectionIntro
				class="hero__intro"
				level={1}
				id="page-title"
				eyebrow="Neutral marketing scaffold"
				title="A clear headline for the homepage"
				lede="Short supporting copy that explains the value without committing to a brand vibe."
			/>

			<div class="hero__cta" aria-label="Primary actions">
				<Button href="/#contact" variant="primary">Primary CTA</Button>
				<Button href="/#services" variant="secondary">Explore services</Button>
			</div>
		</div>
	</section>

	<section class="section" id="services" aria-labelledby="services-title">
		<div class="container stack stack--lg">
			<SectionIntro
				id="services-title"
				title="Services"
				lede="Placeholder section for services, using consistent gutters and spacing."
			/>

			<div class="narrow stack stack--lg">
				<FeatureIconCard
					title="Fancy icon card"
					description="Opt-in React island with motion, only loaded when visible."
					items={["Hover sparkle", "Respects reduced motion", "Token-based color"]}
					iconName="sparkles"
					iconColor="var(--color-primary)"
				/>

				<FeatureIconCard
					title="Fancy icon card (variant)"
					description="Same hover effects, calmer tone via tokens."
					items={["Client:visible", "No motion when reduced", "Accessible SVG"]}
					iconName="shield"
					iconColor="var(--color-text-muted)"
				/>
			</div>
		</div>
	</section>

	<section class="section" id="about" aria-labelledby="about-title">
		<div class="container stack stack--lg">
			<SectionIntro id="about-title" title="About" lede="Placeholder section for about information." />

			<div class="narrow">
				<Accordion
					items={[
						{ id: 'about-1', title: 'What we do', content: 'Placeholder accordion content.', iconName: 'sparkles' },
						{ id: 'about-2', title: 'How to book', content: 'Placeholder accordion content.', iconName: 'shield' },
						{ id: 'about-3', title: 'Accessibility', content: 'Placeholder accordion content.', iconName: 'sparkles' },
					]}
				/>
			</div>
		</div>
	</section>

	<section class="section" id="gallery" aria-labelledby="gallery-title">
		<div class="container stack">
			<SectionIntro id="gallery-title" title="Gallery" lede="Placeholder section for gallery content." />
		</div>
	</section>

	<section class="section" id="contact" aria-labelledby="contact-title">
		<div class="container stack stack--lg">
			<SectionIntro
				id="contact-title"
				title="Contact"
				lede="Placeholder section for contact information."
			/>

			<div class="back-to-top">
				<Button href="#top" variant="ghost">Back to top</Button>
			</div>
		</div>
	</section>
</BaseLayout>
