---
import SectionIntro from "../ui/SectionIntro.astro";
import Card from "../ui/Card.astro";
import FeatureIconCard from "../FeatureIconCard.astro";
import Gallery from "../Gallery.astro";
import HeroBookNowCta from "../motion/HeroBookNowCta";
import HeroBackdrop from "../motion/HeroBackdrop";

import { Star } from "@lucide/astro";

import { getMessages, type Lang } from "../../i18n";

type Props = {
	lang: Lang;
};

const { lang } = Astro.props;
const messages = getMessages(lang);

const vagaroServicesUrl = "https://www.vagaro.com/byastridbeautysalon";
const vagaroPricesUrl = "https://www.vagaro.com/byastridbeautysalon/services";

const stripOuterQuotes = (text: string) => {
	const trimmed = text.trim();
	return trimmed.replace(/^["“'‘]+/, "").replace(/["”'’]+$/, "");
};

const balanceForTwoColumnGrid = <T,>(items: readonly T[], getText: (item: T) => string) => {
	const sorted = [...items].sort((a, b) => getText(a).length - getText(b).length);
	const longHalf = sorted.slice(Math.ceil(sorted.length / 2)).reverse();
	const shortHalf = sorted.slice(0, Math.ceil(sorted.length / 2));
	const balanced: T[] = [];
	const shortQueue = [...shortHalf];

	for (const item of longHalf) {
		balanced.push(item);
		const shortItem = shortQueue.shift();
		if (shortItem !== undefined) balanced.push(shortItem);
	}

	return balanced;
};

const reviews = messages.reviews;

const balancedReviews = balanceForTwoColumnGrid(reviews, (review) => stripOuterQuotes(review.quote));

const orderedReviews = (() => {
	const next = [...balancedReviews];
	const julesIndex = next.findIndex((review) => review.author === "Jules D");
	const anyiIndex = next.findIndex((review) => review.author === "Anyi F");
	if (julesIndex !== -1 && anyiIndex !== -1) {
		const julesReview = next[julesIndex];
		const anyiReview = next[anyiIndex];
		if (julesReview && anyiReview) {
			next[julesIndex] = anyiReview;
			next[anyiIndex] = julesReview;
		}
	}
	return next;
})();

const serviceCardMeta = [
	{ iconName: "consultation", iconColor: "var(--color-icon-scalp)" },
	{ iconName: "scissors", iconColor: "var(--color-icon-cut)" },
	{ iconName: "palette", iconColor: "var(--color-icon-signature)" },
	{ iconName: "sparkles", iconColor: "var(--color-icon-signature)" },
	{ iconName: "droplet", iconColor: "var(--color-icon-gloss)" },
	{ iconName: "waves", iconColor: "var(--color-icon-scalp)" },
] as const;

const staffCards = [
	{ id: "astrid", ...messages.about.staff.members.astrid },
	{ id: "cindy", ...messages.about.staff.members.cindy },
];
---

<section class="section hero" aria-labelledby="page-title">
	<HeroBackdrop client:idle />
	<div class="container hero__grid">
		<div class="hero__content">
			<p class="sr-only">{messages.home.brandSrOnly}</p>
			<div class="hero__brandmark" aria-hidden="true" data-reveal>
				<img
					class="hero__brandmarkLogo"
					src="/by-astrid-beauty-logo.png"
					alt=""
					width="801"
					height="692"
					loading="eager"
					fetchpriority="high"
					decoding="async"
				/>
			</div>
		</div>

		<div class="hero__actions" aria-label="Primary actions">
			<div class="hero__actionsCopy" data-reveal data-reveal-delay="80">
				<h1 class="hero__actionsTitle" id="page-title">{messages.sections.homeTitle}</h1>
				<p class="hero__actionsLede">{messages.home.heroLede}</p>
			</div>
			<div class="hero__actionsRow">
				<div class="hero__ctaStack">
					<HeroBookNowCta
						client:idle
						href={vagaroServicesUrl}
						label={messages.misc.scheduleAppointment}
						labelMobile={messages.misc.bookNow}
						className="hero__bookNow"
					/>
					<p class="hero__ctaHelper">{messages.home.heroCtaHelper}</p>
				</div>
			</div>
		</div>
	</div>
</section>

<section class="section section--muted" id="services" aria-labelledby="services-title">
	<div class="container stack stack--lg">
		<div data-reveal>
			<SectionIntro
				id="services-title"
				title={messages.sections.servicesTitle}
				lede={messages.services.lede}
			/>
		</div>

		<div class="services-grid" aria-label="Service highlights">
			{messages.services.cards.map((card, index) => (
				<div data-reveal data-reveal-delay={String(index * 70)}>
					<FeatureIconCard
						title={card.title}
						meta={`${messages.services.startingAtLabel} ${card.startingAt}`}
						description={card.description}
						items={card.items}
						iconName={serviceCardMeta[index]?.iconName ?? "palette"}
						iconColor={serviceCardMeta[index]?.iconColor ?? "var(--color-primary)"}
					/>
				</div>
			))}
		</div>

		<div class="section-divider" aria-hidden="true" data-reveal data-reveal-delay="50"></div>

		<div class="services-actions" data-reveal data-reveal-delay="70">
			<HeroBookNowCta
				client:idle
				href={vagaroPricesUrl}
				label={messages.misc.viewPrices}
				labelMobile={messages.misc.viewPrices}
				className="services__viewPrices"
			/>
		</div>

		<div class="services-disclaimer" data-reveal data-reveal-delay="80">
			<p class="services-disclaimer__text">{messages.services.disclaimer.line1}</p>
			<p class="services-disclaimer__text">{messages.services.disclaimer.line2}</p>
		</div>
	</div>
</section>

<section class="section section--bg" id="about" aria-labelledby="about-title">
	<div class="container stack stack--lg about__stack">
		<div data-reveal>
			<SectionIntro id="about-title" title={messages.sections.galleryTitle} lede={messages.sections.aboutLede} />
		</div>

		<div data-reveal data-reveal-delay="120">
			<Gallery lang={lang} />
		</div>
	</div>
</section>

<section class="section section--muted" aria-labelledby="reviews-title">
	<div class="container stack stack--lg">
		<section class="booking-reviews" aria-labelledby="reviews-title">
			<header class="booking-reviews__header">
				<h3 class="about__sectionTitle booking-reviews__title" id="reviews-title">{messages.booking.reviewsTitle}</h3>
			</header>
			<div class="reviews-grid" role="list" aria-label={messages.booking.reviewsTitle}>
				{orderedReviews.map((review, index) => (
					<Card
						as="figure"
						variant="default"
						padding="md"
						hover={true}
						class="review"
						role="listitem"
						data-reveal
						data-reveal-delay={String(index * 70)}
					>
						<div class="review__rating" role="img" aria-label="5 out of 5 stars">
							<Star class="review__star" size={16} aria-hidden="true" focusable="false" fill="currentColor" stroke="none" />
							<Star class="review__star" size={16} aria-hidden="true" focusable="false" fill="currentColor" stroke="none" />
							<Star class="review__star" size={16} aria-hidden="true" focusable="false" fill="currentColor" stroke="none" />
							<Star class="review__star" size={16} aria-hidden="true" focusable="false" fill="currentColor" stroke="none" />
							<Star class="review__star" size={16} aria-hidden="true" focusable="false" fill="currentColor" stroke="none" />
						</div>
						<blockquote class="review__quote">{stripOuterQuotes(review.quote)}</blockquote>
						<figcaption class="review__meta">
							<span class="review__author">— {review.author}</span>
							<time class="review__date" datetime={review.date}>{review.date}</time>
						</figcaption>
					</Card>
				))}
			</div>
		</section>

		<div class="about__staff">
			<h3
				class="about__sectionTitle booking-reviews__title"
				id="staff-title"
				data-reveal
				data-reveal-delay="80"
			>
				{messages.about.staff.title}
			</h3>
			<div class="staff-grid" role="list" aria-labelledby="staff-title">
				{staffCards.map((member, index) => (
					<Card
						as="article"
						variant="default"
						padding="lg"
						hover={true}
						class="staff-card"
						role="listitem"
						data-reveal
						data-reveal-delay={String(120 + index * 50)}
						aria-labelledby={`staff-${member.id}-name`}
					>
						<header class="staff-card__header">
							<h4 class="staff-card__name capitalize" id={`staff-${member.id}-name`}>
								{member.name}
							</h4>
							{member.role ? <span class="staff-card__badge">{member.role}</span> : null}
						</header>
						<div class="staff-card__bio">
							{member.paragraphs.map((paragraph) => (
								<p class="staff-card__text">{paragraph}</p>
							))}
						</div>
					</Card>
				))}
			</div>
		</div>
	</div>
</section>

