---
import Button from "../ui/Button.astro";
import SectionIntro from "../ui/SectionIntro.astro";
import FeatureIconCard from "../FeatureIconCard.astro";
import Gallery from "../Gallery.astro";

import { ExternalLink, Star } from "@lucide/astro";

import { getMessages, type Lang } from "../../i18n";

type Props = {
	lang: Lang;
};

const { lang } = Astro.props;
const messages = getMessages(lang);

const vagaroServicesUrl = "https://www.vagaro.com/byastridbeautysalon/services";

const stripOuterQuotes = (text: string) => {
	const trimmed = text.trim();
	return trimmed.replace(/^["“'‘]+/, "").replace(/["”'’]+$/, "");
};

const balanceForTwoColumnGrid = <T,>(items: readonly T[], getText: (item: T) => string) => {
	const sorted = [...items].sort((a, b) => getText(a).length - getText(b).length);
	const longHalf = sorted.slice(Math.ceil(sorted.length / 2)).reverse();
	const shortHalf = sorted.slice(0, Math.ceil(sorted.length / 2));
	const balanced: T[] = [];
	const shortQueue = [...shortHalf];

	for (const item of longHalf) {
		balanced.push(item);
		const shortItem = shortQueue.shift();
		if (shortItem !== undefined) balanced.push(shortItem);
	}

	return balanced;
};

const reviews = [
	{
		quote:
			"Always takes great care of me to where I had to bring my sister in. She got my sister and I right lol if you aren’t already going here you should ",
		author: "Elizabeth C",
		date: "Aug 14, 2025",
	},
	{
		quote:
			"if you are thinking of going to this salon, do it! she’s amazing, she does a very good job & she’s really nice & sweet, thank you Astrid you are incredible 🤍",
		author: "Anyi F",
		date: "Jul 21, 2023",
	},
	{
		quote:
			"Astrid did such a beautiful job with my haircut! Got the exact results I was looking for. I definitely will be back.",
		author: "Jules D",
		date: "Dec 02, 2022",
	},
	{
		quote:
			"She did an amazing job. I am more than happy with the results. She is very friendly and makes you comfortable. She didn't rush through the process instead took her time , and explained what she did and why she did throughout. Will come again!",
		author: "Ramsha S",
		date: "May 06, 2021",
	},
] as const;

const balancedReviews = balanceForTwoColumnGrid(reviews, (review) => stripOuterQuotes(review.quote));

const orderedReviews = (() => {
	const next = [...balancedReviews];
	const julesIndex = next.findIndex((review) => review.author === "Jules D");
	const anyiIndex = next.findIndex((review) => review.author === "Anyi F");
	if (julesIndex !== -1 && anyiIndex !== -1) {
		const julesReview = next[julesIndex];
		const anyiReview = next[anyiIndex];
		if (julesReview && anyiReview) {
			next[julesIndex] = anyiReview;
			next[anyiIndex] = julesReview;
		}
	}
	return next;
})();

const serviceCardMeta = [
	{ iconName: "palette", iconColor: "var(--color-icon-signature)" },
	{ iconName: "scissors", iconColor: "var(--color-icon-cut)" },
	{ iconName: "droplet", iconColor: "var(--color-icon-gloss)" },
	{ iconName: "waves", iconColor: "var(--color-icon-scalp)" },
] as const;
---

<section class="section hero" aria-labelledby="page-title">
	<div class="container hero__grid">
		<div class="hero__content">
			<p class="sr-only">{messages.home.brandSrOnly}</p>
			<div class="hero__brandmark" aria-hidden="true">
				<img
					class="hero__brandmarkLogo"
					src="/by-astrid-beauty-logo.png"
					alt=""
					width="801"
					height="692"
					decoding="async"
				/>
			</div>
		</div>

		<div class="hero__actions" aria-label="Primary actions">
			<div class="hero__actionsCopy">
				<h1 class="hero__actionsTitle" id="page-title">{messages.sections.homeTitle}</h1>
				<p class="hero__actionsLede">{messages.home.heroLede}</p>
			</div>
			<div class="hero__actionsRow">
				<Button
					href={vagaroServicesUrl}
					variant="primary"
					size="lg"
					target="_blank"
					rel="noopener noreferrer"
					class="hero__bookNow btn--external"
				>
					<span class="btn__externalSpacer" aria-hidden="true"></span>
					<span class="btn__externalLabel">{messages.misc.bookNow}</span>
					<ExternalLink class="btn__externalIcon" size={20} aria-hidden="true" focusable="false" />
				</Button>
			</div>
		</div>
	</div>
</section>

<section class="section" id="services" aria-labelledby="services-title">
	<div class="container stack stack--lg">
		<SectionIntro id="services-title" title={messages.sections.servicesTitle} lede={messages.services.lede} />

		<div class="services-grid" aria-label="Service highlights">
			{messages.services.cards.map((card, index) => (
				<FeatureIconCard
					title={card.title}
					description={card.description}
					items={card.items}
					iconName={serviceCardMeta[index]?.iconName ?? "palette"}
					iconColor={serviceCardMeta[index]?.iconColor ?? "var(--color-primary)"}
				/>
			))}
		</div>
	</div>
</section>

<section class="section" id="about" aria-labelledby="about-title">
	<div class="container stack stack--lg about__stack">
		<SectionIntro id="about-title" title={messages.sections.galleryTitle} lede={messages.sections.aboutLede} />

		<Gallery lang={lang} />

		<div class="about__divider" aria-hidden="true"></div>

		<section class="booking-reviews" aria-label={messages.booking.reviewsTitle}>
			<div class="reviews-grid" role="list" aria-label={messages.booking.reviewsTitle}>
				{orderedReviews.map((review) => (
					<figure class="review" role="listitem">
						<div class="review__rating" role="img" aria-label="5 out of 5 stars">
							<Star class="review__star" size={16} aria-hidden="true" focusable="false" fill="currentColor" stroke="none" />
							<Star class="review__star" size={16} aria-hidden="true" focusable="false" fill="currentColor" stroke="none" />
							<Star class="review__star" size={16} aria-hidden="true" focusable="false" fill="currentColor" stroke="none" />
							<Star class="review__star" size={16} aria-hidden="true" focusable="false" fill="currentColor" stroke="none" />
							<Star class="review__star" size={16} aria-hidden="true" focusable="false" fill="currentColor" stroke="none" />
						</div>
						<blockquote class="review__quote">{stripOuterQuotes(review.quote)}</blockquote>
						<figcaption class="review__meta">
							<span class="review__author">— {review.author}</span>
							<time class="review__date" datetime={review.date}>{review.date}</time>
						</figcaption>
					</figure>
				))}
			</div>
		</section>

		<div class="about__divider" aria-hidden="true"></div>

		<div class="booking-ctaCard" aria-label={messages.misc.bookNow}>
			<div class="booking-ctaCard__panel">
				<p class="booking-ctaCard__lede">{messages.booking.lede}</p>
				<div class="booking-ctaCard__actions" aria-label={messages.booking.scheduleHelper}>
					<Button
						href={vagaroServicesUrl}
						variant="primary"
						size="lg"
						target="_blank"
						rel="noopener noreferrer"
						class="booking-ctaCard__button btn--external"
					>
						<span class="btn__externalSpacer" aria-hidden="true"></span>
						<span class="btn__externalLabel">{messages.misc.bookNow}</span>
						<ExternalLink class="btn__externalIcon" size={20} aria-hidden="true" focusable="false" />
					</Button>
				</div>
				<p class="booking-ctaCard__helper">{messages.booking.scheduleHelper}</p>
			</div>
		</div>
	</div>
</section>

<style>
	.services-grid {
		display: grid;
		gap: var(--space-xl);
		grid-template-columns: 1fr;
		align-items: stretch;
	}

	@media (min-width: 48rem) {
		.services-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: calc(var(--space-xl) + var(--space-sm));
		}
	}

	.hero__bookNow.btn {
		background: var(--color-primary);
		border-color: var(--color-primary);
		color: var(--color-primary-contrast);
	}

	.hero__bookNow.btn:hover {
		background: var(--color-primary-hover);
		border-color: var(--color-primary-hover);
	}

	.btn--external .btn__externalIcon {
		opacity: 0;
		transform: translateY(1px);
		pointer-events: none;
	}

	@media (max-width: 48rem) {
		.btn--external .btn__externalIcon {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.btn--external .btn__externalIcon {
			transition:
				opacity 140ms ease,
				transform 140ms ease;
		}
	}

	.btn--external.btn:hover .btn__externalIcon,
	.btn--external.btn:focus-visible .btn__externalIcon {
		opacity: 1;
		transform: translateY(0);
	}

	.btn--external.btn {
		display: grid;
		grid-template-columns: 20px 1fr 20px;
		column-gap: 0.35rem;
		align-items: center;
		justify-items: center;
	}

	.btn__externalSpacer {
		width: 20px;
		height: 1px;
	}

	.btn__externalLabel {
		display: inline-flex;
		align-items: center;
	}

	.about__stack {
		--stack-gap: var(--space-lg);
	}

	.booking-ctaCard {
		display: flex;
		justify-content: center;
		align-items: stretch;
	}

	.booking-ctaCard__panel {
		position: relative;
		overflow: hidden;
		display: grid;
		gap: var(--space-lg);
		justify-items: center;
		text-align: center;
		padding: calc(var(--space-xl) + var(--space-sm));
		border-radius: var(--radius-lg);
		background:
			linear-gradient(
				180deg,
				color-mix(in oklab, var(--color-surface) 90%, var(--color-surface-muted)) 0%,
				color-mix(in oklab, var(--color-surface) 96%, var(--color-primary)) 100%
			);
		border: 1px solid color-mix(in oklab, var(--color-border) 72%, var(--color-primary));
		box-shadow: none;
		width: 100%;
		max-width: 44rem;
	}

	.booking-ctaCard__panel::before {
		content: "";
		position: absolute;
		inset: -40%;
		background: radial-gradient(
			circle at 40% 20%,
			color-mix(in oklab, var(--color-primary) 28%, transparent) 0%,
			transparent 60%
		);
		opacity: 0.45;
		transform: translate3d(0, 0, 0) scale(1);
		pointer-events: none;
	}

	@media (prefers-reduced-motion: no-preference) {
		.booking-ctaCard__panel::before {
			animation: bookingGlow 5.5s ease-in-out infinite;
		}
	}

	@keyframes bookingGlow {
		0%,
		100% {
			opacity: 0.35;
			transform: scale(1);
		}
		50% {
			opacity: 0.55;
			transform: scale(1.04);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.booking-ctaCard__panel {
			transition:
				border-color 160ms ease,
				box-shadow 160ms ease,
				transform 160ms ease,
				background-color 160ms ease;
		}
	}

	.booking-ctaCard:focus-within .booking-ctaCard__panel {
		border-color: color-mix(in oklab, var(--color-border) 55%, var(--color-text-muted));
		box-shadow: var(--shadow-sm);
	}

	.booking-ctaCard:hover .booking-ctaCard__panel {
		border-color: color-mix(in oklab, var(--color-primary) 42%, var(--color-border));
		box-shadow:
			0 10px 28px -18px color-mix(in oklab, var(--color-primary) 42%, transparent),
			var(--shadow-sm);
	}

	.about__divider {
		width: 100%;
		height: 1px;
		background: color-mix(in oklab, var(--color-border) 78%, var(--color-text-muted));
		opacity: 0.9;
		margin-block: var(--space-md);
	}

	.booking-ctaCard__actions {
		display: grid;
		justify-items: stretch;
		gap: var(--space-xs);
		width: 100%;
		max-width: 34rem;
	}

	.booking-ctaCard__button.btn {
		width: 100%;
		letter-spacing: 0.01em;
		min-height: 3.25rem;
	}

	@media (prefers-reduced-motion: no-preference) {
		.booking-ctaCard__button.btn:hover {
			transform: translateY(-1px);
		}
	}

	.booking-ctaCard__helper {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.72rem;
		line-height: 1.4;
		margin-top: auto;
	}

	.booking-ctaCard__lede {
		margin: 0;
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		line-height: 1.5;
		max-width: 38rem;
	}

	.booking-reviews {
		width: 100%;
	}

	.booking-reviews__header {
		display: flex;
		align-items: baseline;
		gap: var(--space-md);
		margin-bottom: var(--space-md);
		flex-wrap: wrap;
	}

	.booking-reviews__title {
		margin: 0;
		font-size: var(--text-xl);
		color: var(--color-text);
		letter-spacing: -0.01em;
		line-height: 1.1;
	}

	.reviews__more {
		margin: var(--space-sm) 0 0;
		color: var(--color-text-muted);
		font-size: var(--text-xs);
		letter-spacing: 0.01em;
		text-align: right;
	}

	@media (max-width: 30rem) {
		.reviews__more {
			text-align: center;
		}
	}

	.reviews-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-lg);
	}

	@media (min-width: 48rem) {
		.reviews-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space-xl);
		}
	}

	.review {
		margin: 0;
		position: relative;
		padding: var(--space-lg);
		border-radius: var(--radius-lg);
		background: color-mix(in oklab, var(--color-surface-muted) 55%, var(--color-surface));
		border: 1px solid var(--color-border);
		box-shadow: none;
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
	}

	.review:hover,
	.review:focus-within {
		border-color: color-mix(in oklab, var(--color-border) 55%, var(--color-text-muted));
		box-shadow: var(--shadow-sm);
	}

	@media (prefers-reduced-motion: no-preference) {
		.review {
			transition:
				background-color 180ms ease,
				border-color 180ms ease,
				box-shadow 180ms ease,
				transform 180ms ease;
		}

		.review:hover,
		.review:focus-within {
			transform: translateY(-1px);
		}
	}

	.review__rating {
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		color: color-mix(in oklab, var(--color-secondary) 72%, var(--color-primary));
		position: relative;
		z-index: 1;
	}

	@media (prefers-reduced-motion: no-preference) {
		.review__rating {
			transition: transform 180ms ease;
		}

		.review:hover .review__rating,
		.review:focus-within .review__rating {
			transform: translateY(-1px) scale(1.02);
		}
	}

	.review__star {
		display: block;
	}

	.review__quote {
		margin: 0;
		padding-top: var(--space-sm);
		color: var(--color-text);
		line-height: 1.65;
		font-size: var(--text-sm);
		position: relative;
		z-index: 1;
	}

	.review__meta {
		margin-top: auto;
		display: inline-flex;
		flex-direction: column;
		align-items: flex-end;
		justify-content: flex-end;
		gap: 0.1rem;
		align-self: flex-end;
		text-align: right;
		position: relative;
		z-index: 1;
	}

	.review__author {
		color: color-mix(in oklab, var(--color-text) 72%, var(--color-text-muted));
		font-size: var(--text-sm);
		font-weight: 550;
		font-style: italic;
		letter-spacing: 0.01em;
	}

	.review__date {
		color: color-mix(in oklab, var(--color-text-muted) 82%, var(--color-border));
		font-size: 0.72rem;
		letter-spacing: 0.01em;
	}
</style>
