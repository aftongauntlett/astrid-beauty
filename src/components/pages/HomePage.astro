		display: grid;
		gap: calc(var(--space-sm) + 0.25rem);
	}

	.hero__actionsTitle {
		margin: 0;
		font-size: var(--heading-3);
		letter-spacing: -0.01em;
	}

	.hero__actionsLede {
		margin: 0;
		color: var(--color-text-muted);
