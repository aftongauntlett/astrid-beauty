		color: inherit;
	}

	.hero__actionsRow {
		display: grid;
		gap: var(--space-sm);
		justify-items: start;
	}

	.hero__ctaStack {
		display: grid;
		gap: var(--space-xs);
		justify-items: start;
	}

	@media (min-width: 48rem) {
		.hero__actionsRow {
			justify-items: end;
		}

		.hero__ctaStack {
			justify-items: end;
		}
	}

	.hero__ctaHelper {
		margin: 0;
		font-size: 0.68rem;
		color: color-mix(in oklab, var(--color-text-muted) 80%, transparent);
		letter-spacing: 0.012em;
		text-align: right;
	}

	.about__stack {
		--stack-gap: var(--space-lg);
	}

