							</ul>
						</div>
					</div>
				</div>

				<div class="accordion__item" data-reveal data-reveal-delay="270">
					<button
						type="button"
						class="accordion__trigger"
						aria-expanded="false"
						aria-controls="accordion-panel-parking"
						id="accordion-trigger-parking"
					>
						<span class="accordion__triggerText capitalize">{messages.about.policies.items.parking.title}</span>
						<span class="accordion__chevron" aria-hidden="true"></span>
					</button>
					<div
						class="accordion__panel"
						id="accordion-panel-parking"
						role="region"
						aria-labelledby="accordion-trigger-parking"
						hidden
					>
						<div class="accordion__panelInner">
							<ul class="accordion__list" aria-label={messages.about.policies.items.parking.title}>
								{messages.about.policies.items.parking.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</div>
					</div>
				</div>

				<div class="accordion__item" data-reveal data-reveal-delay="320">
					<button
						type="button"
						class="accordion__trigger"
						aria-expanded="false"
						aria-controls="accordion-panel-languages"
						id="accordion-trigger-languages"
					>
						<span class="accordion__triggerText capitalize">{messages.about.policies.items.spokenLanguages.title}</span>
						<span class="accordion__chevron" aria-hidden="true"></span>
					</button>
					<div
						class="accordion__panel"
						id="accordion-panel-languages"
						role="region"
						aria-labelledby="accordion-trigger-languages"
						hidden
					>
						<div class="accordion__panelInner">
							<ul class="accordion__list" aria-label={messages.about.policies.items.spokenLanguages.title}>
								{messages.about.policies.items.spokenLanguages.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="booking-ctaCard" data-reveal>
			<Card variant="default" padding="xl" hover={true} class="booking-ctaCard__panel">
				<p class="booking-ctaCard__lede">{messages.booking.scheduleHelper}</p>
				<div class="booking-ctaCard__actions" aria-label={messages.booking.scheduleHelper}>
					<HeroBookNowCta
						client:idle
						href={vagaroServicesUrl}
						label={messages.misc.scheduleAppointment}
						className="booking-ctaCard__button"
					/>
				</div>
			</Card>
		</div>
	</div>
</section>

<script>
	const initAccordions = () => {
		/** @type {HTMLElement[]} */
		const roots = Array.from(document.querySelectorAll("[data-accordion]"));
		for (const root of roots) {
			/** @type {Element[]} */
			const triggers = Array.from(root.querySelectorAll(".accordion__trigger"));
			for (const triggerEl of triggers) {
				if (!(triggerEl instanceof HTMLButtonElement)) continue;
				const trigger = triggerEl;
				const panelId = trigger.getAttribute("aria-controls");
				if (!panelId) continue;
				const panel = root.querySelector(`#${CSS.escape(panelId)}`);
				if (!(panel instanceof HTMLElement)) continue;

				const collapse = () => {
					trigger.setAttribute("aria-expanded", "false");
					panel.hidden = true;
				};

				const expand = () => {
					trigger.setAttribute("aria-expanded", "true");
					panel.hidden = false;
				};

				collapse();

				trigger.addEventListener("click", () => {
					const expanded = trigger.getAttribute("aria-expanded") === "true";
					if (expanded) {
						collapse();
					} else {
						expand();
					}
				});

				trigger.addEventListener("keydown", (event) => {
					if (event.key === "Escape") {
						const expanded = trigger.getAttribute("aria-expanded") === "true";
						if (expanded) {
							event.preventDefault();
							collapse();
							trigger.focus();
						}
					}
				});
			}
		}
	};

	const run = () => initAccordions();
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", run, { once: true });
	} else {
		run();
	}

	document.addEventListener("astro:page-load", run);
</script>

<style>
	.hero {
		padding-block: calc(var(--section-pad-y) * 1.1);
		position: relative;
		overflow: hidden;
		isolation: isolate;
		background: var(--color-bg);
	}

	html[data-theme="dark"] .hero {
		background:
			radial-gradient(
				1000px 520px at 88% 12%,
				color-mix(in oklab, var(--color-primary) 14%, transparent),
				transparent 60%
			),
			var(--color-bg);
	}

	@media (max-width: 48rem) {
		.hero {
			background: var(--color-bg);
		}

		html[data-theme="dark"] .hero {
			background:
				radial-gradient(
					900px 480px at 88% 12%,
					color-mix(in oklab, var(--color-primary) 14%, transparent),
					transparent 60%
				),
				var(--color-bg);
		}
	}

	.hero__grid {
		justify-items: center;
		position: relative;
		z-index: 1;
	}

	.hero__content {
		justify-content: center;
	}

	.hero__brandmark {
		justify-content: center;
	}

	.hero__brandmarkLogo {
		width: min(100%, clamp(18rem, 34vw, 30rem));
		filter: drop-shadow(
			0 10px 18px color-mix(in oklab, var(--color-shadow) 12%, transparent)
		);
	}

	.hero__actions {
		align-items: center;
	}

	.hero__actionsCopy {
		text-align: center;
	}

	.hero__actionsTitle {
		font-size: var(--heading-2);
		letter-spacing: -0.02em;
	}

	.hero__actionsLede {
		font-size: var(--heading-2);
	}

	.hero__grid {
		display: grid;
		gap: var(--space-xl);
		align-items: start;
	}

	.hero__content {
		min-width: 0;
		max-width: min(46rem, var(--measure));
		display: flex;
		align-items: center;
	}

	.hero__brandmark {
		display: flex;
		align-items: center;
		margin: 0;
		position: relative;
	}

	/* Subtle glow behind logo for better readability in light mode */
	.hero__brandmark::before {
		content: "";
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 140%;
		height: 140%;
		background: radial-gradient(
			circle,
			color-mix(in oklab, var(--color-surface-elevated) 92%, transparent) 0%,
			transparent 65%
		);
		filter: blur(40px);
		opacity: 0;
		pointer-events: none;
		z-index: -1;
	}

	html:not([data-theme="dark"]) .hero__brandmark::before {
		opacity: 0;
	}

	html[data-theme="dark"] .hero__brandmark::before {
		opacity: 0;
	}

	.hero__brandmarkLogo {
		display: block;
		width: min(100%, clamp(16rem, 28vw, 26rem));
		height: auto;
		filter: drop-shadow(
			0 10px 18px color-mix(in oklab, var(--color-text) 12%, transparent)
		);
	}

	.hero__actions {
		width: 100%;
		max-width: 34rem;
		display: grid;
		gap: var(--space-lg);
	}

	.hero__actions .btn {
		width: 100%;
	}

