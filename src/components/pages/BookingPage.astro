---
import SectionIntro from "../ui/SectionIntro.astro";
import Card from "../ui/Card.astro";
import HeroBookNowCta from "../motion/HeroBookNowCta";

import { getMessages, type Lang } from "../../i18n";

type Props = {
	lang: Lang;
};

const { lang } = Astro.props;
const messages = getMessages(lang);

const vagaroServicesUrl = "https://www.vagaro.com/byastridbeautysalon";
---

<section class="section section--muted" aria-labelledby="booking-title">
	<div class="container stack stack--lg">
		<div data-reveal>
			<SectionIntro id="booking-title" title={messages.booking.title} lede={messages.booking.lede} />
		</div>

		<div class="booking__policies" data-accordion>
			<h2 class="booking__sectionTitle" id="policies-title" data-reveal data-reveal-delay="80">{messages.about.policies.title}</h2>
			<div class="accordion" role="group" aria-labelledby="policies-title">
				<div class="accordion__item" data-reveal data-reveal-delay="120">
					<button
						type="button"
						class="accordion__trigger"
						aria-expanded="false"
						aria-controls="accordion-panel-rescheduling"
						id="accordion-trigger-rescheduling"
					>
						<span class="accordion__triggerText capitalize">{messages.about.policies.items.rescheduling.title}</span>
						<span class="accordion__chevron" aria-hidden="true"></span>
					</button>
					<div
						class="accordion__panel"
						id="accordion-panel-rescheduling"
						role="region"
						aria-labelledby="accordion-trigger-rescheduling"
						hidden
					>
						<div class="accordion__panelInner">
							<ul class="accordion__list" aria-label={messages.about.policies.items.rescheduling.title}>
								<li>{messages.about.policies.items.rescheduling.bullets.notice}</li>
								<li>{messages.about.policies.items.rescheduling.bullets.fee}</li>
								<li>
									{messages.about.policies.items.rescheduling.bullets.contactIntro}
									<a class="accordion__link" href="tel:+17037863707">703-786-3707</a>
									{messages.about.policies.items.rescheduling.bullets.contactOutro}
								</li>
							</ul>
							<p class="accordion__note">{messages.about.policies.items.rescheduling.why}</p>
						</div>
					</div>
				</div>

				<div class="accordion__item" data-reveal data-reveal-delay="170">
					<button
						type="button"
						class="accordion__trigger"
						aria-expanded="false"
						aria-controls="accordion-panel-children"
						id="accordion-trigger-children"
					>
						<span class="accordion__triggerText capitalize">{messages.about.policies.items.policies.title}</span>
						<span class="accordion__chevron" aria-hidden="true"></span>
					</button>
					<div
						class="accordion__panel"
						id="accordion-panel-children"
						role="region"
						aria-labelledby="accordion-trigger-children"
						hidden
					>
						<div class="accordion__panelInner">
							<ul class="accordion__list" aria-label={messages.about.policies.items.policies.title}>
								<li>{messages.about.policies.items.policies.body}</li>
							</ul>
						</div>
					</div>
				</div>

				<div class="accordion__item" data-reveal data-reveal-delay="220">
					<button
						type="button"
						class="accordion__trigger"
						aria-expanded="false"
						aria-controls="accordion-panel-payment"
						id="accordion-trigger-payment"
					>
						<span class="accordion__triggerText capitalize">{messages.about.policies.items.paymentMethods.title}</span>
						<span class="accordion__chevron" aria-hidden="true"></span>
					</button>
					<div
						class="accordion__panel"
						id="accordion-panel-payment"
						role="region"
						aria-labelledby="accordion-trigger-payment"
						hidden
					>
						<div class="accordion__panelInner">
							<ul class="accordion__list accordion__list--cols3" aria-label={messages.about.policies.items.paymentMethods.title}>
								{messages.about.policies.items.paymentMethods.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</div>
					</div>
				</div>

				<div class="accordion__item" data-reveal data-reveal-delay="270">
					<button
						type="button"
						class="accordion__trigger"
						aria-expanded="false"
						aria-controls="accordion-panel-parking"
						id="accordion-trigger-parking"
					>
						<span class="accordion__triggerText capitalize">{messages.about.policies.items.parking.title}</span>
						<span class="accordion__chevron" aria-hidden="true"></span>
					</button>
					<div
						class="accordion__panel"
						id="accordion-panel-parking"
						role="region"
						aria-labelledby="accordion-trigger-parking"
						hidden
					>
						<div class="accordion__panelInner">
							<ul class="accordion__list" aria-label={messages.about.policies.items.parking.title}>
								{messages.about.policies.items.parking.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</div>
					</div>
				</div>

				<div class="accordion__item" data-reveal data-reveal-delay="320">
					<button
						type="button"
						class="accordion__trigger"
						aria-expanded="false"
						aria-controls="accordion-panel-languages"
						id="accordion-trigger-languages"
					>
						<span class="accordion__triggerText capitalize">{messages.about.policies.items.spokenLanguages.title}</span>
						<span class="accordion__chevron" aria-hidden="true"></span>
					</button>
					<div
						class="accordion__panel"
						id="accordion-panel-languages"
						role="region"
						aria-labelledby="accordion-trigger-languages"
						hidden
					>
						<div class="accordion__panelInner">
							<ul class="accordion__list" aria-label={messages.about.policies.items.spokenLanguages.title}>
								{messages.about.policies.items.spokenLanguages.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<section class="section section--bg" aria-label={messages.misc.bookNow}>
	<div class="container stack stack--lg">
		<div class="booking-ctaCard" data-reveal>
			<Card variant="glow" padding="xl" hover={false} class="booking-ctaCard__panel">
				<p class="booking-ctaCard__lede">{messages.booking.lede}</p>
				<div class="booking-ctaCard__actions" aria-label={messages.booking.scheduleHelper}>
					<HeroBookNowCta
						client:idle
						href={vagaroServicesUrl}
						label={messages.misc.bookNow}
						className="booking-ctaCard__button"
					/>
				</div>
				<p class="booking-ctaCard__helper">{messages.booking.scheduleHelper}</p>
			</Card>
		</div>
	</div>
</section>

<script>
	const initAccordions = () => {
		/** @type {typeof globalThis & { __astrid_bookingAccordionsController?: AbortController }} */
		const g = globalThis;

		g.__astrid_bookingAccordionsController?.abort?.();
		const controller = new AbortController();
		g.__astrid_bookingAccordionsController = controller;
		const { signal } = controller;

		document.addEventListener("astro:before-swap", () => controller.abort(), { once: true, signal });

		/** @type {HTMLElement[]} */
		const roots = Array.from(document.querySelectorAll("[data-accordion]"));
		for (const root of roots) {
			/** @type {Element[]} */
			const triggers = Array.from(root.querySelectorAll(".accordion__trigger"));
			for (const triggerEl of triggers) {
				if (!(triggerEl instanceof HTMLButtonElement)) continue;
				const trigger = triggerEl;

				const panelId = trigger.getAttribute("aria-controls");
				if (!panelId) continue;
				const panel = root.querySelector(`#${CSS.escape(panelId)}`);
				if (!(panel instanceof HTMLElement)) continue;

				const collapse = () => {
					trigger.setAttribute("aria-expanded", "false");
					panel.hidden = true;
				};

				const expand = () => {
					trigger.setAttribute("aria-expanded", "true");
					panel.hidden = false;
				};

				collapse();

				trigger.addEventListener(
					"click",
					() => {
						const expanded = trigger.getAttribute("aria-expanded") === "true";
						if (expanded) collapse();
						else expand();
					},
					{ signal }
				);

				trigger.addEventListener(
					"keydown",
					(event) => {
						if (event.key === "Escape") {
							const expanded = trigger.getAttribute("aria-expanded") === "true";
							if (expanded) {
								event.preventDefault();
								collapse();
								trigger.focus();
							}
						}
					},
					{ signal }
				);
			}
		}
	};

	const run = () => initAccordions();
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", run, { once: true });
	} else {
		run();
	}

	document.addEventListener("astro:page-load", run);
</script>

<style>
	.booking__sectionTitle {
		margin: 0;
		font-size: var(--heading-3);
		text-align: center;
	}

	.accordion {
		display: grid;
		gap: var(--space-sm);
	}

	.accordion__item {
		border: 1px solid color-mix(in oklab, var(--color-border) 70%, transparent);
		border-radius: var(--radius-lg);
		background: color-mix(in oklab, var(--color-surface) 92%, var(--color-surface-muted));
		overflow: hidden;
	}

	html[data-theme="dark"] .accordion__item {
		background: color-mix(in oklab, var(--color-surface) 70%, var(--color-bg));
	}

	.accordion__trigger {
		appearance: none;
		width: 100%;
		text-align: left;
		border: 0;
		background: transparent;
		color: var(--color-text);
		padding: var(--space-md) var(--space-lg);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
		font: inherit;
		font-weight: 650;
		cursor: pointer;
		position: relative;
		isolation: isolate;
	}

	.accordion__trigger::before {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: var(--radius-lg);
		background: color-mix(in oklab, var(--color-primary) 12%, var(--color-surface));
		opacity: 0;
		pointer-events: none;
		z-index: 0;
	}

	.accordion__trigger[aria-expanded="true"]::before {
		border-radius: var(--radius-lg) var(--radius-lg) 0 0;
	}

	.accordion__triggerText,
	.accordion__chevron {
		position: relative;
		z-index: 1;
	}

	@media (prefers-reduced-motion: no-preference) {
		.accordion__trigger {
			transition:
				color var(--motion-duration-normal) var(--motion-ease-standard),
				background-color var(--motion-duration-normal) var(--motion-ease-standard);
		}

		.accordion__trigger::before {
			transition: opacity var(--motion-duration-normal) var(--motion-ease-standard);
		}
	}

	.accordion__trigger:hover,
	.accordion__trigger:focus-visible {
		color: var(--color-primary);
		background-color: transparent;
	}

	.accordion__trigger:hover::before,
	.accordion__trigger:focus-visible::before {
		opacity: 0.42;
	}

	.accordion__trigger:active {
		background-color: transparent;
	}

	.accordion__trigger:active::before {
		opacity: 0.55;
	}

	.accordion__trigger[aria-expanded="true"] {
		color: var(--color-primary);
		background-color: transparent;
	}

	.accordion__trigger[aria-expanded="true"]::before {
		opacity: 0.62;
	}

	.accordion__trigger:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 2px;
	}

	.accordion__chevron {
		width: 10px;
		height: 10px;
		color: currentColor;
		border-right: 2px solid currentColor;
		border-bottom: 2px solid currentColor;
		transform: rotate(45deg);
		flex: 0 0 auto;
		opacity: 0.78;
	}

	.accordion__trigger:hover .accordion__chevron,
	.accordion__trigger:focus-visible .accordion__chevron,
	.accordion__trigger[aria-expanded="true"] .accordion__chevron {
		opacity: 0.98;
	}

	@media (prefers-reduced-motion: no-preference) {
		.accordion__chevron {
			transition:
				transform var(--motion-duration-normal) var(--motion-ease-standard),
				opacity var(--motion-duration-normal) var(--motion-ease-standard);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.accordion__trigger,
		.accordion__chevron {
			transition: none;
		}
	}

	.accordion__trigger[aria-expanded="true"] .accordion__chevron {
		transform: rotate(-135deg);
	}

	.accordion__panelInner {
		padding: var(--space-md) var(--space-lg) var(--space-lg);
		display: grid;
		gap: var(--space-xs);
	}

	.accordion__list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: var(--space-xs);
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		line-height: 1.55;
	}

	.accordion__list--cols3 {
		grid-template-columns: repeat(3, minmax(0, 1fr));
		column-gap: var(--space-lg);
	}

	@media (max-width: 47.999rem) {
		.accordion__list--cols3 {
			grid-template-columns: 1fr;
		}
	}

	.accordion__list li {
		display: flex;
		align-items: flex-start;
		gap: var(--space-sm);
	}

	.accordion__list li::before {
		content: "-";
		color: color-mix(in oklab, var(--color-text-muted) 82%, var(--color-text));
		margin-top: 0.02em;
		flex: 0 0 auto;
	}

	.accordion__note {
		margin: 0;
		margin-top: var(--space-sm);
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		line-height: 1.55;
	}

	.accordion__link {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 0.16em;
		font-weight: 650;
	}

	.booking-ctaCard {
		display: flex;
		justify-content: center;
		align-items: stretch;
	}

	:global(.booking-ctaCard__panel) {
		position: relative;
		overflow: hidden;
		display: grid;
		gap: var(--space-lg);
		justify-items: center;
		text-align: center;
		background:
			linear-gradient(
				180deg,
				color-mix(in oklab, var(--color-surface) 90%, var(--color-surface-muted)) 0%,
				color-mix(in oklab, var(--color-surface) 96%, var(--color-primary)) 100%
			);
		width: 100%;
		max-width: 44rem;
	}

	:global(.booking-ctaCard__panel)::before {
		content: "";
		position: absolute;
		inset: -40%;
		background: radial-gradient(
			circle at 40% 20%,
			color-mix(in oklab, var(--color-primary) 28%, transparent) 0%,
			transparent 60%
		);
		opacity: 0.45;
		transform: translate3d(0, 0, 0) scale(1);
		pointer-events: none;
	}

	@media (prefers-reduced-motion: no-preference) {
		:global(.booking-ctaCard__panel)::before {
			animation: bookingGlow 5.5s ease-in-out infinite;
		}
	}

	@keyframes bookingGlow {
		0%,
		100% {
			opacity: 0.35;
			transform: scale(1);
		}
		50% {
			opacity: 0.55;
			transform: scale(1.04);
		}
	}

	.booking-ctaCard__actions {
		display: grid;
		justify-items: center;
		gap: var(--space-xs);
		width: 100%;
		max-width: 34rem;
		margin-top: var(--space-lg);
	}

	.booking-ctaCard__button.btn {
		width: auto;
		letter-spacing: 0.01em;
		min-height: 3.25rem;
	}

	@media (prefers-reduced-motion: no-preference) {
		.booking-ctaCard__button.btn:hover {
			transform: translateY(-1px);
		}
	}

	.booking-ctaCard__helper {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.72rem;
		line-height: 1.4;
		margin-top: auto;
	}

	.booking-ctaCard__lede {
		margin: 0;
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		line-height: 1.5;
		max-width: 38rem;
	}
</style>
