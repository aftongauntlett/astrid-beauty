---
import SectionIntro from "../ui/SectionIntro.astro";
import Card from "../ui/Card.astro";
import Accordion from "../ui/Accordion.astro";
import HeroBookNowCta from "../motion/HeroBookNowCta";

import { getMessages, type Lang } from "../../i18n";

type Props = {
	lang: Lang;
};

const { lang } = Astro.props;
const messages = getMessages(lang);

const vagaroServicesUrl = "https://www.vagaro.com/byastridbeautysalon";
---

<section class="section section--muted" aria-labelledby="booking-title">
	<div class="container stack stack--lg">
		<div data-reveal>
			<SectionIntro id="booking-title" level={1} title={messages.booking.title} lede={messages.booking.lede} />
		</div>

		<Accordion
			rootClass="booking__policies"
			policies={messages.about.policies}
			ariaLabelledBy="policies-title"
			idPrefix="booking-policies"
			renderTitle={true}
			titleId="policies-title"
			titleRevealDelay="80"
		/>
	</div>
</section>

<section class="section section--bg" aria-label={messages.misc.bookNow}>
	<div class="container stack stack--lg">
		<div class="booking-ctaCard" data-reveal>
			<Card variant="glow" padding="xl" hover={false} class="booking-ctaCard__panel">
				<p class="booking-ctaCard__lede">{messages.booking.lede}</p>
				<p class="booking-ctaCard__lede booking-ctaCard__lede--second">{messages.booking.scheduleHelper}</p>
				<div class="booking-ctaCard__actions" aria-label={messages.booking.scheduleHelper}>
					<HeroBookNowCta
						client:idle
						href={vagaroServicesUrl}
						label={messages.misc.scheduleAppointment}
						labelMobile={messages.misc.bookNow}
						disableEntranceAnimation={true}
					/>
				</div>
			</Card>
		</div>
	</div>
</section>

<style>
	.booking-ctaCard {
		display: flex;
		justify-content: center;
		align-items: stretch;
	}

	:global(.booking-ctaCard__panel) {
		position: relative;
		overflow: hidden;
		display: grid;
		gap: var(--space-lg);
		justify-items: center;
		text-align: center;
		background:
			linear-gradient(
				180deg,
				color-mix(in oklab, var(--color-surface-muted) 88%, var(--color-bg)) 0%,
				color-mix(in oklab, var(--color-surface) 90%, var(--color-primary) 8%) 100%
			);
		width: 100%;
		max-width: 44rem;
	}

	html:not([data-theme="dark"]) :global(.booking-ctaCard__panel) {
		border-color: color-mix(in oklab, var(--color-border) 90%, transparent);
		background:
			linear-gradient(
				180deg,
				color-mix(in oklab, var(--color-surface-elevated) 86%, var(--color-primary) 6%) 0%,
				color-mix(in oklab, var(--color-surface-muted) 72%, var(--color-primary) 10%) 100%
			);
		box-shadow: var(--shadow-md);
	}

	html[data-theme="dark"] :global(.booking-ctaCard__panel) {
		background:
			linear-gradient(
				180deg,
				color-mix(in oklab, var(--color-surface) 76%, var(--color-bg)) 0%,
				color-mix(in oklab, var(--color-surface) 70%, var(--color-bg)) 100%
			);
	}

	:global(.booking-ctaCard__panel)::before {
		content: "";
		position: absolute;
		inset: -40%;
		background: radial-gradient(
			circle at 40% 20%,
			color-mix(in oklab, var(--color-primary) 28%, transparent) 0%,
			transparent 60%
		);
		opacity: 0.4;
		transform: translate3d(0, 0, 0);
		pointer-events: none;
	}

	.booking-ctaCard__actions {
		display: grid;
		justify-items: center;
		gap: var(--space-xs);
		width: 100%;
		max-width: 34rem;
		margin-top: 0;
	}

	.booking-ctaCard__lede {
		margin: 0;
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		line-height: 1.5;
		max-width: 38rem;
	}
</style>
