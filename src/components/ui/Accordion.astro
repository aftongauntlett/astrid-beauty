---
import { Shield, Sparkles } from "@lucide/astro";

export interface AccordionItem {
	id: string;
	title: string;
	content: string;
	iconName?: "sparkles" | "shield";
}

export interface Props {
	items: AccordionItem[];
}

const { items } = Astro.props;
---

<div class="accordion">
	{items.map((item) => {
		const Icon = item.iconName === "shield" ? Shield : Sparkles;
		return (
			<details class="accordion__item" name="accordion">
				<summary class="accordion__summary capitalize" id={item.id}>
					<span class="accordion__summaryInner">
						<Icon class="accordion__icon" size={18} aria-hidden="true" focusable="false" />
						<span class="accordion__title">{item.title}</span>
					</span>
				</summary>
				<div class="accordion__content">
					<p>{item.content}</p>
				</div>
			</details>
		);
	})}
</div>

<style>
	.accordion {
		display: grid;
		gap: var(--space-sm);
	}

	.accordion__item {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		overflow: hidden;
		box-shadow: var(--shadow-sm);
	}

	.accordion__summary {
		list-style: none;
		cursor: pointer;
		padding: 0 var(--space-lg);
		min-height: var(--control-height);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
		font-weight: 600;
		color: var(--color-text);
		background: transparent;
	}

	.accordion__summaryInner {
		display: inline-flex;
		align-items: center;
		gap: var(--space-sm);
		min-width: 0;
	}

	.accordion__icon {
		color: currentColor;
		flex: 0 0 auto;
	}

	.accordion__title {
		min-width: 0;
	}

	.accordion__summary::-webkit-details-marker {
		display: none;
	}

	.accordion__summary:hover {
		background: var(--color-surface-muted);
	}

	.accordion__summary:hover {
		color: var(--color-primary);
	}

	.accordion__summary::after {
		content: "";
		flex: 0 0 auto;
		width: 0.75rem;
		height: 0.75rem;
		border-right: 2px solid var(--color-text-muted);
		border-bottom: 2px solid var(--color-text-muted);
		transform: rotate(45deg);
	}

	.accordion__summary:hover::after {
		border-right-color: var(--color-primary);
		border-bottom-color: var(--color-primary);
	}

	@media (prefers-reduced-motion: no-preference) {
		.accordion__summary::after {
			transition: transform 160ms ease;
		}

		.accordion__summary {
			transition: color 160ms ease, background-color 160ms ease;
		}
	}

	.accordion__item[open] > .accordion__summary {
		background: var(--color-surface-muted);
	}

	.accordion__item[open] > .accordion__summary::after {
		transform: rotate(-135deg);
	}

	.accordion__summary:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 2px;
	}

	.accordion__content {
		padding: var(--space-sm) var(--space-lg) var(--space-lg);
		color: var(--color-text-muted);
	}

	.accordion__content p {
		margin: 0;
	}
</style>
