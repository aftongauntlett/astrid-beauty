---
export interface AccordionItem {
	id: string;
	title: string;
	content: string;
}

export interface Props {
	items: AccordionItem[];
}

const { items } = Astro.props;
---

<div class="accordion">
	{items.map((item) => (
		<details class="accordion__item" name="accordion">
			<summary class="accordion__summary" id={item.id}>
				{item.title}
			</summary>
			<div class="accordion__content">
				<p>{item.content}</p>
			</div>
		</details>
	))}
</div>

<style>
	.accordion {
		display: grid;
		gap: var(--space-sm);
	}

	.accordion__item {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		overflow: hidden;
		box-shadow: var(--shadow-sm);
	}

	.accordion__summary {
		list-style: none;
		cursor: pointer;
		padding: 0 var(--space-lg);
		min-height: var(--control-height);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
		font-weight: 600;
		color: var(--color-text);
		background: transparent;
	}

	.accordion__summary::-webkit-details-marker {
		display: none;
	}

	.accordion__summary:hover {
		background: var(--color-surface-muted);
	}

	.accordion__summary::after {
		content: "";
		flex: 0 0 auto;
		width: 0.75rem;
		height: 0.75rem;
		border-right: 2px solid var(--color-text-muted);
		border-bottom: 2px solid var(--color-text-muted);
		transform: rotate(45deg);
	}

	@media (prefers-reduced-motion: no-preference) {
		.accordion__summary::after {
			transition: transform 160ms ease;
		}
	}

	.accordion__item[open] > .accordion__summary {
		background: var(--color-surface-muted);
	}

	.accordion__item[open] > .accordion__summary::after {
		transform: rotate(-135deg);
	}

	.accordion__summary:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 2px;
	}

	.accordion__content {
		padding: var(--space-sm) var(--space-lg) var(--space-lg);
		color: var(--color-text-muted);
	}

	.accordion__content p {
		margin: 0;
	}
</style>
