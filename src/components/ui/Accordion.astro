---
export interface AccordionItem {
	id: string;
	title: string;
	content: string;
}

export interface Props {
	items: AccordionItem[];
}

const { items } = Astro.props;
---

<div class="accordion">
	{items.map((item) => (
		<details class="accordion__item" name="accordion">
			<summary class="accordion__summary" id={item.id}>
				{item.title}
			</summary>
			<div class="accordion__content">
				<p>{item.content}</p>
			</div>
		</details>
	))}
</div>

<style>
	.accordion {
		display: grid;
		gap: var(--space-sm);
	}

	.accordion__item {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		overflow: hidden;
	}

	.accordion__summary {
		cursor: pointer;
		padding: var(--space-sm) var(--space-md);
		font-weight: 600;
	}

	.accordion__summary:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 2px;
	}

	.accordion__content {
		padding: 0 var(--space-md) var(--space-md);
		color: var(--color-text-muted);
	}

	.accordion__content p {
		margin: 0;
	}
</style>
