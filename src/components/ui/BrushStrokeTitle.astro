---
export interface Props {
	class?: string;
	as?: "span" | "div";
}

import TitleSparkles from "../motion/TitleSparkles";

const { class: className = "", as = "span" } = Astro.props as Props;

const Tag = as;
---

<Tag class={`bst ${className}`.trim()} data-bst>
	<span class="bst__text"><slot /></span>
	<TitleSparkles client:visible />
</Tag>

<style>
	.bst {
		position: relative;
		display: inline-block;
		isolation: isolate;
		vertical-align: middle;
		padding: 0.24em 0.5em;
	}

	.bst__text {
		position: relative;
		z-index: 1;
	}

	/* ---------- styles for TitleSparkles (React-rendered) ---------- */

	:global(.bst__fx) {
		position: absolute;
		inset: -4px -10px;
		z-index: 0;
		pointer-events: none;
	}

	:global(.bst__glow) {
		position: absolute;
		inset: -2px -6px;
		border-radius: 8px;
		opacity: 0;
		background: radial-gradient(
			ellipse at 50% 60%,
			color-mix(in oklab, var(--color-secondary) 22%, transparent) 0%,
			color-mix(in oklab, var(--color-secondary) 10%, transparent) 45%,
			transparent 78%
		);
		filter: blur(6px);
	}

	:global(.bst__sparkle) {
		position: absolute;
		border-radius: 50%;
		background: var(--color-secondary);
		box-shadow: 0 0 6px 1px
			color-mix(in oklab, var(--color-secondary) 55%, transparent);
		pointer-events: none;
	}

	/* ---------- accessibility / input-type overrides ---------- */

	@media (prefers-reduced-motion: reduce) {
		:global(.bst__fx) {
			display: none;
		}
	}

	@media (hover: none) {
		:global(.bst__fx) {
			display: none;
		}
	}
</style>
