---
export type CardVariant = "default" | "elevated" | "subtle" | "glow";
export type CardPadding = "none" | "sm" | "md" | "lg" | "xl";

export interface Props {
	variant?: CardVariant;
	padding?: CardPadding;
	hover?: boolean;
	class?: string;
	as?: "div" | "article" | "figure";
	[key: string]: unknown;
}

const {
	variant = "default",
	padding = "md",
	hover = true,
	as = "div",
	class: className,
	...rest
} = Astro.props as Props;

const classes = [
	"card",
	`card--${variant}`,
	`card--pad-${padding}`,
	hover ? "card--hover" : null,
	className,
].filter(Boolean);
---

{as === "article" ? (
	<article class={classes.join(" ")} {...rest}>
		<slot />
	</article>
) : as === "figure" ? (
	<figure class={classes.join(" ")} {...rest}>
		<slot />
	</figure>
) : (
	<div class={classes.join(" ")} {...rest}>
		<slot />
	</div>
)}

<style>
	.card {
		border-radius: var(--radius-lg);
		position: relative;
	}

	.card--default {
		background: var(--color-surface);
		border: 1px solid color-mix(in oklab, var(--color-border) 65%, transparent);
		box-shadow:
			0 1px 2px 0 rgba(0, 0, 0, 0.05),
			0 8px 24px -12px rgba(0, 0, 0, 0.12),
			0 16px 48px -16px rgba(0, 0, 0, 0.08);
	}

	html:not([data-theme="dark"]) .card--default {
		background: var(--surface-glass);
		border-color: color-mix(in oklab, var(--color-border) 82%, transparent);
		box-shadow:
			0 1px 2px 0 rgba(0, 0, 0, 0.05),
			0 8px 24px -12px rgba(0, 0, 0, 0.12),
			0 16px 48px -16px rgba(0, 0, 0, 0.08),
			inset 0 1px 0 var(--glass-highlight),
			inset 0 0 0 1px var(--glass-rim);
	}

	@media (min-width: 48rem) {
		@supports (backdrop-filter: blur(1px)) {
			html:not([data-theme="dark"]):not([data-dev-mode="true"]) .card--default {
				backdrop-filter: blur(16px) saturate(1.1);
				-webkit-backdrop-filter: blur(16px) saturate(1.1);
			}
		}
	}

	html:not([data-theme="dark"]) .card--default::before {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		pointer-events: none;
		background: linear-gradient(
			180deg,
			color-mix(in oklab, white 72%, transparent) 0%,
			transparent 48%
		);
		opacity: 0.55;
		z-index: 0;
	}

	html[data-theme="dark"] .card--default {
		background: color-mix(in oklab, var(--color-surface) 85%, var(--color-accent-soft));
		border-color: color-mix(in oklab, var(--color-text-muted) 22%, var(--color-border));
	}

	.card--default > * {
		position: relative;
		z-index: 1;
	}

	.card--elevated {
		background: linear-gradient(
			180deg,
			color-mix(in oklab, var(--color-primary) 3%, var(--color-surface-elevated)) 0%,
			var(--color-surface) 78%
		);
		border: 1px solid color-mix(in oklab, var(--color-border) 65%, transparent);
		box-shadow: var(--shadow-sm);
	}

	.card--subtle {
		background: color-mix(in oklab, var(--color-surface-muted) 55%, var(--color-surface));
		border: 1px solid color-mix(in oklab, var(--color-border) 70%, transparent);
		box-shadow: none;
	}

	.card--glow {
		overflow: hidden;
		isolation: isolate;
		border: 1px solid color-mix(in oklab, var(--color-border) 72%, var(--color-primary));
		box-shadow: none;
	}

	html[data-theme="dark"] .card--glow {
		border-color: color-mix(in oklab, var(--color-text-muted) 22%, var(--color-border));
	}

	.card--glow::after {
		content: "";
		position: absolute;
		inset: -55%;
		border-radius: 999px;
		pointer-events: none;
		opacity: 0.22;
		background: radial-gradient(
			circle,
			color-mix(in oklab, var(--color-primary) 18%, transparent) 0%,
			transparent 65%
		);
		filter: blur(18px);
		z-index: 0;
	}

	html[data-theme="dark"] .card--glow::after {
		opacity: 0.18;
		background: radial-gradient(
			circle,
			color-mix(in oklab, var(--color-text-muted) 24%, transparent) 0%,
			transparent 68%
		);
	}

	.card--glow > * {
		position: relative;
		z-index: 1;
	}

	.card--pad-none {
		padding: 0;
	}

	.card--pad-sm {
		padding: var(--space-md);
	}

	.card--pad-md {
		padding: var(--space-lg);
	}

	.card--pad-lg {
		padding: var(--space-xl);
	}

	.card--pad-xl {
		padding: calc(var(--space-xl) + var(--space-sm));
	}

	@media (prefers-reduced-motion: no-preference) {
		.card--hover {
			transition:
				background-color var(--motion-duration-normal) var(--motion-ease-luxury),
				box-shadow var(--motion-duration-normal) var(--motion-ease-luxury),
				border-color var(--motion-duration-normal) var(--motion-ease-luxury),
				transform var(--motion-duration-normal) var(--motion-ease-luxury);
		}

		.card--hover:focus-within {
			transform: none;
			box-shadow: var(--shadow-md);
			border-color: color-mix(in oklab, var(--color-secondary) 30%, var(--color-border));
		}

		html[data-theme="dark"] .card--hover:focus-within {
			border-color: color-mix(in oklab, var(--color-text-muted) 24%, var(--color-border));
			box-shadow:
				var(--shadow-md),
				0 0 0 1px color-mix(in oklab, var(--color-text-muted) 16%, transparent),
				0 12px 28px -22px color-mix(in oklab, var(--color-text-muted) 34%, transparent);
		}

		html:not([data-theme="dark"]) .card--hover:focus-within.card--default {
			background: color-mix(in oklab, var(--color-surface-elevated) 92%, var(--color-secondary) 8%);
		}

		html[data-theme="dark"] .card--hover:focus-within.card--default {
			background: color-mix(in oklab, var(--color-surface) 84%, var(--color-bg));
		}

		html:not([data-theme="dark"]) .card--hover:focus-within.card--default::before {
			opacity: 0.72;
		}
	}

	@media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
		.card--hover:hover {
			transform: none;
			box-shadow: var(--shadow-md);
			border-color: color-mix(in oklab, var(--color-secondary) 30%, var(--color-border));
		}

		html[data-theme="dark"] .card--hover:hover {
			border-color: color-mix(in oklab, var(--color-text-muted) 24%, var(--color-border));
			box-shadow:
				var(--shadow-md),
				0 0 0 1px color-mix(in oklab, var(--color-text-muted) 16%, transparent),
				0 12px 28px -22px color-mix(in oklab, var(--color-text-muted) 34%, transparent);
		}

		html:not([data-theme="dark"]) .card--hover:hover.card--default {
			background: color-mix(in oklab, var(--color-surface-elevated) 92%, var(--color-secondary) 8%);
		}

		html[data-theme="dark"] .card--hover:hover.card--default {
			background: color-mix(in oklab, var(--color-surface) 84%, var(--color-bg));
		}

		html:not([data-theme="dark"]) .card--hover:hover.card--default::before {
			opacity: 0.72;
		}
	}
</style>
