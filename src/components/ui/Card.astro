---
const hasHeader = Astro.slots.has("header");
const hasFooter = Astro.slots.has("footer");
---

<article class="card">
	{hasHeader ? (
		<header class="card__header">
			<slot name="header" />
		</header>
	) : null}

	<div class="card__body">
		<slot />
	</div>

	{hasFooter ? (
		<footer class="card__footer">
			<slot name="footer" />
		</footer>
	) : null}
</article>

<style>
	.card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: var(--shadow-sm);
	}

	.card__header,
	.card__body,
	.card__footer {
		padding: var(--space-lg);
	}

	.card__header {
		border-bottom: 1px solid var(--color-border);
	}

	.card__headerRow {
		display: flex;
		align-items: baseline;
		gap: var(--space-sm);
	}

	.card__headerContent {
		min-width: 0;
		flex: 1 1 auto;
	}

	.card__icon {
		--card-icon-color: var(--color-text);

		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: var(--card-icon-color);
		flex: 0 0 auto;
	}

	.card__icon--default {
		--card-icon-color: var(--color-text);
	}

	.card__icon--muted {
		--card-icon-color: var(--color-text-muted);
	}

	.card__icon--primary {
		--card-icon-color: var(--color-primary);
	}

	:global(.card__headerContent > :first-child) {
		margin: 0;
	}

	.card__footer {
		border-top: 1px solid var(--color-border);
	}
</style>
