---
import HeroBookNowCta from "../../motion/HeroBookNowCta";
import HeroBackdrop from "../../motion/HeroBackdrop";

import type { Messages } from "../../../i18n/types";

export type Props = {
	messages: Messages;
	vagaroServicesUrl: string;
};

const { messages, vagaroServicesUrl } = Astro.props;
const heroTitle = messages.sections.homeTitle;
const splitTitleSuffix = "Astrid's Beauty Salon";
const canSplitHeroTitle = /astrid'?s beauty salon$/i.test(heroTitle);
const heroTitleLead = canSplitHeroTitle
	? "Welcome To"
	: heroTitle;
---

<section class="section hero" aria-labelledby="page-title">
	<HeroBackdrop client:load />
	<div class="container hero__grid">
		<div class="hero__content">
			<p class="sr-only">{messages.home.brandSrOnly}</p>
			<figure class="hero__brandPanel" data-reveal>
				<img
					class="hero__brandImage"
					src="/images/purple-hair-color.jpg"
					alt="Purple toned salon color result"
					width="900"
					height="1200"
					loading="eager"
					fetchpriority="high"
					decoding="async"
				/>
			</figure>
		</div>

		<div class="hero__actions">
			<div class="hero__actionsCopy" data-reveal data-reveal-delay="80">
				<h1 class="hero__actionsTitle" id="page-title">
					{canSplitHeroTitle ? (
						<>
							<span class="hero__actionsTitleLead">{heroTitleLead}</span>
							<span class="hero__actionsTitleMain">{splitTitleSuffix}</span>
						</>
					) : (
						heroTitle
					)}
				</h1>
				<p class="hero__actionsLede">{messages.home.heroLede}</p>
			</div>
			<div class="hero__actionsRow">
				<div class="hero__ctaStack">
					<div class="hero__ctaButtons">
						<HeroBookNowCta
							client:idle
							href="#booking"
							label={messages.misc.learnMore}
							labelMobile={messages.misc.learnMore}
							variant="secondary"
							icon="down"
							target="_self"
							className="hero__learnMore"
						/>
						<HeroBookNowCta
							client:idle
							href={vagaroServicesUrl}
							label={messages.misc.scheduleAppointment}
							labelMobile={messages.misc.bookNow}
							variant="primary"
						/>
					</div>
					<p class="hero__ctaHelper">{messages.misc.appointmentOnly}*</p>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		padding-block: calc(var(--section-pad-y) * 1.1);
		position: relative;
		overflow: hidden;
		isolation: isolate;
		background: var(--color-bg);
	}

	/* Light mode: warm ambient glow to make hero feel alive */
	html:not([data-theme="dark"]) .hero {
		background:
			radial-gradient(
				980px 560px at 22% 44%,
				color-mix(in oklab, var(--color-sage) 18%, transparent),
				transparent 64%
			),
			radial-gradient(
				860px 500px at 76% 14%,
				color-mix(in oklab, var(--color-blush) 14%, transparent),
				transparent 56%
			),
			radial-gradient(
				740px 420px at 80% 68%,
				color-mix(in oklab, var(--color-secondary) 12%, transparent),
				transparent 58%
			),
			var(--color-bg);
	}

	/* Light mode: add a gentle separator into the next section */
	html:not([data-theme="dark"]) .hero::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 44px;
		pointer-events: none;
		background: linear-gradient(
			180deg,
			transparent 0%,
			color-mix(in oklab, var(--color-primary) 4%, var(--color-surface-muted)) 70%,
			color-mix(in oklab, var(--color-primary) 3%, var(--color-surface-muted)) 100%
		);
		opacity: 0.32;
	}

	html[data-theme="dark"] .hero {
		background:
			radial-gradient(
				900px 500px at 85% 8%,
				color-mix(in oklab, var(--color-secondary) 10%, transparent),
				transparent 55%
			),
			radial-gradient(
				700px 400px at 80% 20%,
				color-mix(in oklab, #6b4c8a 8%, transparent),
				transparent 60%
			),
			var(--color-bg);
	}

	@media (max-width: 48rem) {
		html:not([data-theme="dark"]) .hero {
			background:
				radial-gradient(
					640px 360px at 20% 30%,
					color-mix(in oklab, var(--color-sage) 14%, transparent),
					transparent 62%
				),
				radial-gradient(
					580px 320px at 82% 16%,
					color-mix(in oklab, var(--color-blush) 12%, transparent),
					transparent 60%
				),
				var(--color-bg);
		}

		html[data-theme="dark"] .hero {
			background:
				radial-gradient(
					800px 450px at 80% 10%,
					color-mix(in oklab, var(--color-secondary) 10%, transparent),
					transparent 55%
				),
				radial-gradient(
					600px 350px at 75% 25%,
					color-mix(in oklab, #6b4c8a 8%, transparent),
					transparent 60%
				),
				var(--color-bg);
		}
	}

	.hero__grid {
		justify-items: center;
		position: relative;
		z-index: 1;
	}

	.hero__content {
		justify-content: center;
	}

	.hero__actions {
		align-items: center;
	}

	.hero__actionsCopy {
		text-align: center;
	}

	.hero__actionsTitle {
		font-size: var(--heading-2);
		letter-spacing: -0.02em;
	}

	.hero__actionsLede {
		font-size: var(--heading-2);
	}

	.hero__grid {
		display: grid;
		gap: var(--space-xl);
		align-items: start;
	}

	.hero__content {
		min-width: 0;
		max-width: min(46rem, var(--measure));
		display: flex;
		align-items: center;
	}

	@media (max-width: 35.999rem) {
		.hero__grid {
			gap: var(--space-lg);
		}

		.hero__content {
			display: none;
		}

		html:not([data-theme="dark"]) .hero__actions::before {
			display: none;
		}
	}

	.hero__brandPanel {
		position: relative;
		display: grid;
		gap: var(--space-md);
		align-content: start;
		margin: 0;
		width: min(100%, 28rem);
		padding: 0;
		border-radius: 0;
		border: 0;
		background: transparent;
		box-shadow: none;
		isolation: isolate;
	}

	.hero__brandPanel::before {
		content: "";
		position: absolute;
		inset: 8% -8% -10%;
		background: radial-gradient(
			circle at 50% 42%,
			color-mix(in oklab, var(--color-secondary) 22%, transparent) 0%,
			transparent 70%
		);
		filter: blur(24px);
		opacity: 0.34;
		pointer-events: none;
		z-index: 0;
	}

	html[data-theme="dark"] .hero__brandPanel::before {
		opacity: 0.24;
	}

	.hero__brandImage {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 0.95rem;
		border: 0;
		box-shadow: 0 18px 36px -26px color-mix(in oklab, var(--color-primary) 36%, transparent);
		position: relative;
		z-index: 1;
		transform: translateZ(0);
		transform-origin: center center;
		backface-visibility: hidden;
		will-change: transform;
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero__brandImage {
			transition: transform var(--motion-duration-slow) var(--motion-ease-luxury);
		}
	}

	@media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
		.hero__brandPanel:hover .hero__brandImage {
			transform: translateZ(0) scale(1.01);
		}
	}
	.hero__actions {
		width: 100%;
		max-width: 44rem;
		display: grid;
		gap: var(--space-lg);
		position: relative;
		isolation: isolate;
	}

	html:not([data-theme="dark"]) .hero__actions::before {
		content: "";
		position: absolute;
		inset: -1.2rem -1rem -1.1rem;
		border-radius: 1.25rem;
		background:
			radial-gradient(
				ellipse at 50% 35%,
				color-mix(in oklab, var(--color-surface-elevated) 96%, transparent) 0%,
				color-mix(in oklab, var(--color-surface) 92%, transparent) 56%,
				transparent 82%
			),
			linear-gradient(
				180deg,
				color-mix(in oklab, var(--color-surface-elevated) 88%, transparent) 0%,
				transparent 100%
			);
		filter: blur(10px);
		opacity: 0.86;
		pointer-events: none;
		z-index: 0;
	}

	.hero__actions > * {
		position: relative;
		z-index: 1;
	}

	.hero__actions .btn {
		width: 100%;
	}

	html:not([data-theme="dark"]) :global(.hero__learnMore.btn--secondary) {
		background-color: transparent;
		color: color-mix(in oklab, var(--color-primary) 80%, var(--color-secondary));
		border-color: color-mix(in oklab, var(--color-secondary) 38%, transparent);
		box-shadow: none;
	}

	html:not([data-theme="dark"]) :global(.hero__learnMore.btn--secondary:hover),
	html:not([data-theme="dark"]) :global(.hero__learnMore.btn--secondary:focus-visible) {
		background-color: color-mix(in oklab, var(--color-secondary) 12%, transparent);
		color: color-mix(in oklab, var(--color-primary) 74%, var(--color-secondary));
		border-color: color-mix(in oklab, var(--color-secondary) 52%, transparent);
		box-shadow: var(--shadow-sm);
	}

	.hero__actionsCopy {
		display: grid;
		gap: calc(var(--space-sm) + 0.25rem);
	}

	.hero__actionsTitle {
		margin: 0;
		font-size: var(--heading-3);
		letter-spacing: -0.01em;
		text-wrap: balance;
	}

	.hero__actionsTitleLead,
	.hero__actionsTitleMain {
		display: block;
	}

	.hero__actionsTitleLead {
		font-family: var(--font-script);
		font-style: normal;
		font-weight: 400;
		font-size: clamp(2.2rem, 3.2vw + 1rem, 4rem);
		line-height: 0.98;
		letter-spacing: 0.004em;
		color: color-mix(in oklab, var(--color-primary) 72%, var(--color-secondary));
	}

	.hero__actionsTitleMain {
		font-family: var(--font-heading);
		font-style: normal;
		font-weight: 600;
		line-height: 1.04;
		letter-spacing: -0.015em;
		color: color-mix(in oklab, var(--color-primary) 86%, var(--color-text-muted));
	}

	html:not([data-theme="dark"]) .hero__actionsTitleMain {
		color: color-mix(in oklab, var(--color-primary) 84%, var(--color-text-muted));
	}

	.hero__actionsLede {
		margin: 0;
		color: var(--color-text-muted);
	}

	.hero__actionsRow {
		margin-top: var(--space-xs);
	}

	@media (min-width: 34rem) {
		.hero__actionsRow {
			grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
			align-items: stretch;
		}
	}

	@media (min-width: 60rem) {
		.hero__grid {
			grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.9fr);
			align-items: center;
			justify-items: stretch;
		}

		.hero__actions {
			justify-self: start;
			align-items: stretch;
		}

		.hero__actionsCopy {
			text-align: left;
		}

		.hero__brandPanel {
			width: min(100%, 24rem);
		}
	}

	/* Hero: visible H1 tuned to be slightly larger than section H2s */
	.hero__actionsTitle {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: calc(var(--heading-2) * 1.06);
		line-height: 1.05;
		letter-spacing: -0.015em;
	}

	.hero__actionsLede {
		font-size: var(--text-base);
	}

	.hero__actionsRow {
		display: grid;
		gap: var(--space-sm);
		justify-items: center;
	}

	.hero__ctaStack {
		display: grid;
		gap: var(--space-xs);
		justify-items: center;
	}

	.hero__ctaButtons {
		display: grid;
		gap: var(--space-sm);
		width: 100%;
	}

	@media (min-width: 34rem) {
		.hero__ctaButtons {
			grid-template-columns: 1fr 1fr;
			align-items: stretch;
		}
	}

	@media (min-width: 48rem) {
		.hero__actionsRow {
			justify-items: end;
		}

		.hero__ctaStack {
			justify-items: end;
		}
	}

	.hero__ctaHelper {
		padding-top: var(--space-xs);
		margin: 0;
		font-size: 0.78rem;
		color: color-mix(in oklab, var(--color-text-muted) 80%, transparent);
		letter-spacing: 0.012em;
		text-align: center;
	}

	@media (min-width: 48rem) {
		.hero__ctaHelper {
			text-align: right;
		}
	}
</style>
