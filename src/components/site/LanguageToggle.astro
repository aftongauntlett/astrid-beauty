---
import { getMessages, type Lang } from "../../i18n";
import { toLangPath } from "../../i18n/routes";

type Mode = "desktop" | "mobile";

type Props = {
	lang: Lang;
	mode?: Mode;
};

const { lang, mode = "desktop" } = Astro.props;
const messages = getMessages(lang);

const isEn = lang === "en";
const rootClass = mode === "mobile" ? "lang-toggle lang-toggle--mobile" : "lang-toggle lang-toggle--desktop";

const pathname = Astro.url.pathname;
const enHref = toLangPath(pathname, "en");
const esHref = toLangPath(pathname, "es");
---

<nav class={rootClass} aria-label={messages.common.languageToggleLabel} data-lang-toggle>
	<a
		href={enHref}
		class="lang-toggle__link"
		data-lang="en"
		aria-current={isEn ? "page" : undefined}
	>
		English
	</a>
	<a
		href={esHref}
		class="lang-toggle__link"
		data-lang="es"
		aria-current={!isEn ? "page" : undefined}
	>
		Español
	</a>
</nav>

<script is:inline>
	(() => {
		try {
			const root = document.currentScript?.closest('[data-lang-toggle]');
			if (!(root instanceof HTMLElement)) return;
			root.addEventListener('click', (event) => {
				const target = event.target;
				if (!(target instanceof HTMLAnchorElement)) return;
				const value = target.getAttribute('data-lang');
				if (value !== 'en' && value !== 'es') return;
				try {
					localStorage.setItem('preferredLang', value);
				} catch {
					// ignore
				}
			});
		} catch {
			// ignore
		}
	})();
</script>

<style>
	.lang-toggle {
		display: inline-flex;
		align-items: center;
		gap: var(--space-xs);
		padding: var(--space-xs);
		border: 1px solid var(--color-divider);
		border-radius: var(--radius-md);
		background: var(--color-surface-elevated);
	}

	.lang-toggle__link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: calc(var(--control-height) - 0.5rem);
		padding: 0 var(--space-sm);
		border-radius: var(--radius-md);
		color: var(--color-text);
		text-decoration: none;
		font-weight: 600;
		white-space: nowrap;
	}

	.lang-toggle__link:hover {
		color: var(--color-primary);
		background: var(--color-surface-muted);
	}

	.lang-toggle__link[aria-current="page"] {
		color: var(--color-primary);
		background: var(--color-surface-muted);
	}

	/* Desktop instance is hidden on mobile */
	.lang-toggle--desktop {
		display: none;
	}

	@media (min-width: 48rem) {
		.lang-toggle--desktop {
			display: inline-flex;
		}
		.lang-toggle--mobile {
			display: none;
		}
	}

	/* Mobile instance should stretch inside the menu */
	.lang-toggle--mobile {
		width: 100%;
		justify-content: space-between;
	}

	.lang-toggle--mobile .lang-toggle__link {
		flex: 1 1 0;
	}
</style>
