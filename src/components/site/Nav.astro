---
import Button from "../ui/Button.astro";
import SettingsMenu from "./SettingsMenu.astro";
import { getMessages, type Lang } from "../../i18n";

export interface Props {
	lang: Lang;
}

const menuId = "primary-nav-menu";

const { lang } = Astro.props;
const messages = getMessages(lang);

const sectionHref = (id: string) => (lang === "es" ? `/es#${id}` : `/#${id}`);

const vagaroServicesUrl = "https://www.vagaro.com/byastridbeautysalon/services";
---

<nav class="nav" aria-label="Primary">
	<Button
		type="button"
		variant="ghost"
		size="sm"
		class="nav__toggle"
		aria-expanded="false"
		aria-controls={menuId}
		data-nav-toggle
	>
		{messages.nav.menu}
	</Button>

	<div class="nav__menu" id={menuId} hidden data-nav-menu>
		<a class="nav__link" href={sectionHref("services")} data-section-link="services">{messages.nav.services}</a>
		<a class="nav__link" href={sectionHref("about")} data-section-link="about">{messages.nav.gallery}</a>
		<a
			class="nav__link nav__link--book"
			href={vagaroServicesUrl}
			target="_blank"
			rel="noopener noreferrer"
		>
			{messages.misc.bookNow}
		</a>
		<div class="nav__divider" aria-hidden="true"></div>
		<SettingsMenu lang={lang} mode="mobile" />
	</div>
</nav>

<script>
	const root = document.currentScript?.closest("nav");
	if (!(root instanceof HTMLElement)) {
		// no-op
	} else {
		const toggle = root.querySelector("[data-nav-toggle]");
		const menu = root.querySelector("[data-nav-menu]");

		if (!(toggle instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) {
			// no-op
		} else {
			const toggleButton = toggle;
			const menuEl = menu;

			const openMenu = () => {
				toggleButton.setAttribute("aria-expanded", "true");
				menuEl.hidden = false;
			};
			const closeMenu = () => {
				toggleButton.setAttribute("aria-expanded", "false");
				menuEl.hidden = true;
			};

			closeMenu();

			toggleButton.addEventListener("click", () => {
				const isOpen = toggleButton.getAttribute("aria-expanded") === "true";
				if (isOpen) closeMenu();
				else openMenu();
			});

			root.addEventListener("keydown", (event) => {
				if (event.key === "Escape") {
					closeMenu();
					toggleButton.focus();
				}
			});

			menuEl.addEventListener("click", (event) => {
				const target = event.target;
				if (target instanceof HTMLAnchorElement) {
					closeMenu();
				}
			});

			// Active section state (Home pages only)
			if (window.location.pathname === "/" || window.location.pathname === "/es" || window.location.pathname === "/es/") {
				const sectionLinks = Array.from(root.querySelectorAll("[data-section-link]"));

				const linkById = new Map();
				for (const el of sectionLinks) {
					if (el instanceof HTMLAnchorElement) {
						const id = el.getAttribute("data-section-link");
						if (id) linkById.set(id, el);
					}
				}

				const getHeaderOffsetPx = () => {
					const header = document.querySelector(".site-header");
					if (!(header instanceof HTMLElement)) return 0;
					return Math.ceil(header.getBoundingClientRect().height);
				};

				const clearCurrent = () => {
					for (const link of linkById.values()) link.removeAttribute("aria-current");
				};

				const setCurrentSection = (id = "") => {
					clearCurrent();
					const link = linkById.get(id);
					if (link) link.setAttribute("aria-current", "location");
				};

				let observer = new IntersectionObserver(() => {}, {
					rootMargin: "0px",
					threshold: [0],
				});
				const latest = new Map();
				let activeId = "";

				const applyBestActive = () => {
					let bestId = "";
					let bestRatio = 0;
					let bestTop = Number.POSITIVE_INFINITY;

					for (const [id, entry] of latest.entries()) {
						if (!entry.isIntersecting) continue;
						const top = entry.boundingClientRect.top;
						const ratio = entry.intersectionRatio;
						if (ratio > bestRatio || (ratio === bestRatio && top < bestTop)) {
							bestRatio = ratio;
							bestTop = top;
							bestId = id;
						}
					}

					const nearTop = window.scrollY < 8;
					if (!bestId && nearTop) {
						if (activeId !== "__top__") {
							activeId = "__top__";
							clearCurrent();
						}
						return;
					}

					if (!bestId) return;
					if (bestId !== activeId) {
						activeId = bestId;
						setCurrentSection(bestId);
					}
				};

				const setupObserver = () => {
					observer.disconnect();
					latest.clear();
					activeId = "";
					clearCurrent();

					const headerOffset = getHeaderOffsetPx();
					const topMargin = -(headerOffset + 8);
					observer = new IntersectionObserver(
						(entries) => {
							for (const entry of entries) {
								const el = entry.target;
								if (!(el instanceof HTMLElement)) continue;
								const id = el.id;
								if (!id) continue;
								latest.set(id, entry);
							}
							applyBestActive();
						},
						{
							rootMargin: `${topMargin}px 0px -60% 0px`,
							threshold: [0, 0.1, 0.25, 0.5, 0.75, 1],
						}
					);

					for (const id of linkById.keys()) {
						const section = document.getElementById(id);
						if (section) observer.observe(section);
					}
				};

				setupObserver();
				window.addEventListener("resize", () => {
					// Recompute header offset + margins
					setupObserver();
				});
				window.addEventListener("scroll", () => {
					// Handles the "top of page" home state
					applyBestActive();
				}, { passive: true });
			}
		}
	}
</script>

<style>
	.nav {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
	}

	.nav__toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-xs);
		min-height: var(--control-height);
		padding: 0 var(--space-md);
	}

	.nav__toggle.btn {
		box-shadow: none;
		border: 1px solid transparent;
		padding: 0 var(--space-md);
		min-height: var(--control-height);
	}

	.nav__menu {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		flex-wrap: nowrap;
	}

	.nav__link {
		display: inline-flex;
		align-items: center;
		min-height: var(--control-height);
		color: var(--color-text);
		text-decoration: none;
		padding: 0 var(--space-md);
		border-radius: var(--radius-md);
		position: relative;
		flex: 0 0 auto;
		white-space: nowrap;
		transition: color 160ms ease;
	}

	/* Refined underline: animates in smoothly on hover + focus-visible */
	.nav__link::after {
		content: "";
		position: absolute;
		left: var(--space-md);
		right: var(--space-md);
		bottom: 0.45rem;
		height: var(--stroke-1);
		border-radius: 9999px;
		background: color-mix(in oklab, var(--color-primary) 65%, transparent);
		opacity: 0;
		transform: scaleX(0.6);
		transform-origin: center;
		transition:
			opacity 160ms ease,
			transform 180ms ease,
			background-color 160ms ease;
	}

	.nav__link:hover,
	.nav__link:focus-visible {
		color: var(--color-primary);
	}

	.nav__link:hover::after,
	.nav__link:focus-visible::after {
		opacity: 1;
		transform: scaleX(1);
	}

	/* Subtle current-section treatment (no pill backgrounds). */
	.nav__link[aria-current="location"],
	.nav__link[aria-current="page"] {
		color: var(--color-primary);
	}

	.nav__link[aria-current="location"]::after,
	.nav__link[aria-current="page"]::after {
		opacity: 1;
		transform: scaleX(1);
	}

	/* “Book now” is a link, but gently highlighted with a premium glow. */
	.nav__link--book {
		isolation: isolate;
		font-weight: 700;
		color: var(--color-primary);
	}

	.nav__link--book:hover,
	.nav__link--book:focus-visible {
		color: var(--color-primary-hover);
	}

	.nav__link--book::before {
		content: "";
		position: absolute;
		inset: 0.35rem 0.5rem;
		border-radius: var(--radius-md);
		background: color-mix(in oklab, var(--color-primary) 20%, transparent);
		filter: blur(14px);
		opacity: 0.45;
		z-index: -1;
		animation: nav-book-breathe 3.4s ease-in-out infinite;
	}

	@keyframes nav-book-breathe {
		0%,
		100% {
			opacity: 0.35;
			transform: scale(0.985);
		}
		50% {
			opacity: 0.6;
			transform: scale(1.01);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.nav__link::after {
			transition: none;
		}
		.nav__link--book::before {
			animation: none;
			opacity: 0.45;
			transform: none;
		}
	}

	.nav__divider {
		width: 100%;
		height: 1px;
		background: var(--color-border);
		margin: var(--space-xs) 0;
	}

	/* Mobile: toggle reveals vertical menu */
	@media (max-width: 48rem) {
		.nav {
			position: relative;
		}

		.nav__menu {
			position: absolute;
			top: calc(100% + var(--space-sm));
			right: 0;
			flex-direction: column;
			align-items: stretch;
			min-width: 14rem;
			padding: var(--space-sm);
			background: var(--color-surface);
			border: 1px solid var(--color-border);
			border-radius: var(--radius-md);
			box-shadow: var(--shadow-md);
		}

		.nav__link {
			width: 100%;
			justify-content: flex-start;
		}

		.nav__link::after {
			left: var(--space-md);
			right: var(--space-md);
			bottom: 0.35rem;
		}
	}

	/* Desktop: menu always visible, toggle hidden */
	@media (min-width: 48.001rem) {
		.nav__toggle {
			display: none;
		}

		.nav__menu {
			position: static;
			padding: 0;
			border: 0;
			background: transparent;
		}
	}
</style>
