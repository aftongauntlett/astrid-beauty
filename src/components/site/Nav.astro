---
const menuId = "primary-nav-menu";
---

<nav class="nav" aria-label="Primary">
	<button
		type="button"
		class="nav__toggle"
		aria-expanded="false"
		aria-controls={menuId}
		data-nav-toggle
	>
		Menu
	</button>

	<div class="nav__menu" id={menuId} hidden data-nav-menu>
		<a class="nav__link" href="/" data-home-link>Home</a>
		<a class="nav__link" href="/#services" data-section-link="services">Services</a>
		<a class="nav__link" href="/#about" data-section-link="about">About</a>
		<a class="nav__link" href="/#gallery" data-section-link="gallery">Gallery</a>
		<a class="nav__link" href="/#contact" data-section-link="contact">Contact</a>
	</div>
</nav>

<script>
	// @ts-check
	/** @type {HTMLElement | null} */
	const root = document.currentScript?.closest("nav");
	if (!root) {
		// no-op
	} else {
		/** @type {HTMLButtonElement | null} */
		const toggle = root.querySelector("[data-nav-toggle]");
		/** @type {HTMLElement | null} */
		const menu = root.querySelector("[data-nav-menu]");

		if (!(toggle instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) {
			// no-op
		} else {
			const toggleButton = toggle;
			const menuEl = menu;

			const openMenu = () => {
				toggleButton.setAttribute("aria-expanded", "true");
				menuEl.hidden = false;
			};
			const closeMenu = () => {
				toggleButton.setAttribute("aria-expanded", "false");
				menuEl.hidden = true;
			};

			closeMenu();

			toggleButton.addEventListener("click", () => {
				const isOpen = toggleButton.getAttribute("aria-expanded") === "true";
				if (isOpen) closeMenu();
				else openMenu();
			});

			root.addEventListener("keydown", (event) => {
				if (event.key === "Escape") {
					closeMenu();
					toggleButton.focus();
				}
			});

			menuEl.addEventListener("click", (event) => {
				const target = event.target;
				if (target instanceof HTMLAnchorElement) {
					closeMenu();
				}
			});

			// Active section state (Home page only)
			if (window.location.pathname === "/") {
				const homeLink = root.querySelector("[data-home-link]");
				const sectionLinks = Array.from(root.querySelectorAll("[data-section-link]"));

				/** @type {Map<string, HTMLAnchorElement>} */
				const linkById = new Map();
				for (const el of sectionLinks) {
					if (el instanceof HTMLAnchorElement) {
						const id = el.getAttribute("data-section-link");
						if (id) linkById.set(id, el);
					}
				}

				const getHeaderOffsetPx = () => {
					const header = document.querySelector(".site-header");
					if (!(header instanceof HTMLElement)) return 0;
					return Math.ceil(header.getBoundingClientRect().height);
				};

				const clearCurrent = () => {
					for (const link of linkById.values()) link.removeAttribute("aria-current");
					if (homeLink instanceof HTMLAnchorElement) homeLink.removeAttribute("aria-current");
				};

				const setCurrentSection = (id = "") => {
					clearCurrent();
					const link = linkById.get(id);
					if (link) link.setAttribute("aria-current", "location");
				};

				const setHomeCurrent = () => {
					clearCurrent();
					if (homeLink instanceof HTMLAnchorElement) homeLink.setAttribute("aria-current", "page");
				};

				let observer = new IntersectionObserver(() => {}, {
					rootMargin: "0px",
					threshold: [0],
				});
				const latest = new Map();
				let activeId = "";

				const applyBestActive = () => {
					let bestId = "";
					let bestRatio = 0;
					let bestTop = Number.POSITIVE_INFINITY;

					for (const [id, entry] of latest.entries()) {
						if (!entry.isIntersecting) continue;
						const top = entry.boundingClientRect.top;
						const ratio = entry.intersectionRatio;
						if (ratio > bestRatio || (ratio === bestRatio && top < bestTop)) {
							bestRatio = ratio;
							bestTop = top;
							bestId = id;
						}
					}

					const nearTop = window.scrollY < 8;
					if (!bestId && nearTop) {
						if (activeId !== "__home__") {
							activeId = "__home__";
							setHomeCurrent();
						}
						return;
					}

					if (!bestId) return;
					if (bestId !== activeId) {
						activeId = bestId;
						setCurrentSection(bestId);
					}
				};

				const setupObserver = () => {
					observer.disconnect();
					latest.clear();
					activeId = "";
					clearCurrent();

					const headerOffset = getHeaderOffsetPx();
					const topMargin = -(headerOffset + 8);
					observer = new IntersectionObserver(
						(entries) => {
							for (const entry of entries) {
								const el = entry.target;
								if (!(el instanceof HTMLElement)) continue;
								const id = el.id;
								if (!id) continue;
								latest.set(id, entry);
							}
							applyBestActive();
						},
						{
							rootMargin: `${topMargin}px 0px -60% 0px`,
							threshold: [0, 0.1, 0.25, 0.5, 0.75, 1],
						}
					);

					for (const id of linkById.keys()) {
						const section = document.getElementById(id);
						if (section) observer.observe(section);
					}
				};

				setupObserver();
				window.addEventListener("resize", () => {
					// Recompute header offset + margins
					setupObserver();
				});
				window.addEventListener("scroll", () => {
					// Handles the "top of page" home state
					applyBestActive();
				}, { passive: true });
			}
		}
	}
</script>

<style>
	.nav {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
	}

	.nav__toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-xs);
		min-height: 2.25rem;
		padding: var(--space-xs) var(--space-sm);
	}

	.nav__menu {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
	}

	.nav__link {
		color: var(--color-text);
		text-decoration: none;
		padding: var(--space-xs) var(--space-sm);
		border-radius: var(--radius-md);
	}

	.nav__link:hover {
		color: var(--color-primary);
	}

	.nav__link[aria-current="location"],
	.nav__link[aria-current="page"] {
		color: var(--color-primary);
		text-decoration: underline;
		text-decoration-thickness: from-font;
		text-underline-offset: 0.2em;
	}

	/* Mobile: toggle reveals vertical menu */
	@media (max-width: 48rem) {
		.nav {
			position: relative;
		}

		.nav__menu {
			position: absolute;
			top: calc(100% + var(--space-sm));
			right: 0;
			flex-direction: column;
			align-items: stretch;
			min-width: 14rem;
			padding: var(--space-sm);
			background: var(--color-surface);
			border: 1px solid var(--color-border);
			border-radius: var(--radius-md);
		}

		.nav__link {
			width: 100%;
		}
	}

	/* Desktop: menu always visible, toggle hidden */
	@media (min-width: 48.001rem) {
		.nav__toggle {
			display: none;
		}

		.nav__menu {
			position: static;
			padding: 0;
			border: 0;
			background: transparent;
		}
	}
</style>
