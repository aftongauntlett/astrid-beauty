---
import Button from "../ui/Button.astro";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageToggle from "./LanguageToggle.astro";
import { getMessages, type Lang } from "../../i18n";
import { ExternalLink, Menu, X } from "@lucide/astro";

export interface Props {
	lang: Lang;
}

const menuId = "primary-nav-menu";

const { lang } = Astro.props;
const messages = getMessages(lang);

const sectionHref = (id: string) => (lang === "es" ? `/es#${id}` : `/#${id}`);

const vagaroServicesUrl = "https://www.vagaro.com/byastridbeautysalon";
---

<nav class="nav" aria-label="Primary" data-primary-nav data-open="false">
	<Button
		type="button"
		variant="ghost"
		size="sm"
		class="nav__toggle"
		aria-expanded="false"
		aria-controls={menuId}
		data-nav-toggle
	>
		<span class="sr-only">{messages.nav.menu}</span>
		<Menu class="nav__toggleIcon nav__toggleIcon--menu" size={18} aria-hidden="true" focusable="false" />
		<X class="nav__toggleIcon nav__toggleIcon--close" size={18} aria-hidden="true" focusable="false" />
	</Button>

	<div class="nav__menu" id={menuId} data-nav-menu>
		<a class="nav__link" href={sectionHref("services")} data-section-link="services">{messages.nav.services}</a>
		<a class="nav__link" href={sectionHref("about")} data-section-link="about">{messages.nav.gallery}</a>
		<Button
			class="nav__bookNow"
			variant="ghost"
			size="sm"
			href={vagaroServicesUrl}
			target="_blank"
			rel="noopener noreferrer"
		>
			<span class="nav__linkText">{messages.misc.bookNow}</span>
			<ExternalLink class="nav__externalIcon" size={18} aria-hidden="true" focusable="false" />
		</Button>
		<div class="nav__divider" aria-hidden="true"></div>
		<div class="nav__settings" aria-label="Settings">
			<ThemeToggle mode="segmented" label="Theme" />
			<LanguageToggle lang={lang} mode="mobile" />
		</div>
	</div>
</nav>

<script>
	const initPrimaryNav = () => {
		const root = document.querySelector("nav[data-primary-nav]");
		if (!(root instanceof HTMLElement)) return;

		globalThis.__astrid_primaryNavController?.abort?.();
		const controller = new AbortController();
		globalThis.__astrid_primaryNavController = controller;
		const { signal } = controller;

		document.addEventListener("astro:before-swap", () => controller.abort(), { once: true, signal });

		const toggle = root.querySelector("[data-nav-toggle]");
		const menu = root.querySelector("[data-nav-menu]");
		if (!(toggle instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;

		const toggleButton = toggle;
		const menuEl = menu;

		const applyState = (open = false) => {
			root.dataset["open"] = open ? "true" : "false";
			toggleButton.setAttribute("aria-expanded", open ? "true" : "false");
			menuEl.toggleAttribute("hidden", !open);
		};

		applyState(false);

		toggleButton.addEventListener(
			"click",
			() => {
				const isOpen = toggleButton.getAttribute("aria-expanded") === "true";
				applyState(!isOpen);
			},
			{ signal }
		);

		document.addEventListener(
			"click",
			(event) => {
				if (!(event.target instanceof Node)) return;
				const isOpen = toggleButton.getAttribute("aria-expanded") === "true";
				if (!isOpen) return;
				if (root.contains(event.target)) return;
				applyState(false);
			},
			{ signal }
		);

		root.addEventListener(
			"keydown",
			(event) => {
				if (event.key === "Escape") {
					applyState(false);
					toggleButton.focus();
				}
			},
			{ signal }
		);

		menuEl.addEventListener(
			"click",
			(event) => {
				const target = event.target;
				if (target instanceof HTMLAnchorElement) {
					applyState(false);
				}
			},
			{ signal }
		);

		// Active section state (Home pages only)
		if (window.location.pathname === "/" || window.location.pathname === "/es" || window.location.pathname === "/es/") {
			const sectionLinks = Array.from(root.querySelectorAll("[data-section-link]"));

			const linkById = new Map();
			for (const el of sectionLinks) {
				if (el instanceof HTMLAnchorElement) {
					const id = el.getAttribute("data-section-link");
					if (id) linkById.set(id, el);
				}
			}

			const getHeaderOffsetPx = () => {
				const header = document.querySelector(".site-header");
				if (!(header instanceof HTMLElement)) return 0;
				return Math.ceil(header.getBoundingClientRect().height);
			};

			const clearCurrent = () => {
				for (const link of linkById.values()) link.removeAttribute("aria-current");
			};

			const setCurrentSection = (id = "") => {
				clearCurrent();
				const link = linkById.get(id);
				if (link) link.setAttribute("aria-current", "location");
			};

			let observer = new IntersectionObserver(() => {}, {
				rootMargin: "0px",
				threshold: [0],
			});
			const latest = new Map();
			let activeId = "";

			signal.addEventListener("abort", () => {
				observer.disconnect();
			});

			const applyBestActive = () => {
				let bestId = "";
				let bestRatio = 0;
				let bestTop = Number.POSITIVE_INFINITY;

				for (const [id, entry] of latest.entries()) {
					if (!entry.isIntersecting) continue;
					const top = entry.boundingClientRect.top;
					const ratio = entry.intersectionRatio;
					if (ratio > bestRatio || (ratio === bestRatio && top < bestTop)) {
						bestRatio = ratio;
						bestTop = top;
						bestId = id;
					}
				}

				const nearTop = window.scrollY < 8;
				if (!bestId && nearTop) {
					if (activeId !== "__top__") {
						activeId = "__top__";
						clearCurrent();
					}
					return;
				}

				if (!bestId) return;
				if (bestId !== activeId) {
					activeId = bestId;
					setCurrentSection(bestId);
				}
			};

			const setupObserver = () => {
				observer.disconnect();
				latest.clear();
				activeId = "";
				clearCurrent();

				const headerOffset = getHeaderOffsetPx();
				const topMargin = -(headerOffset + 8);
				observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							const el = entry.target;
							if (!(el instanceof HTMLElement)) continue;
							const id = el.id;
							if (!id) continue;
							latest.set(id, entry);
						}
						applyBestActive();
					},
					{
						rootMargin: `${topMargin}px 0px -60% 0px`,
						threshold: [0, 0.1, 0.25, 0.5, 0.75, 1],
					}
				);

				for (const id of linkById.keys()) {
					const section = document.getElementById(id);
					if (section) observer.observe(section);
				}
			};

			setupObserver();
			window.addEventListener(
				"resize",
				() => {
					setupObserver();
				},
				{ signal }
			);
			window.addEventListener(
				"scroll",
				() => {
					applyBestActive();
				},
				{ passive: true, signal }
			);
		}
	};

	const run = () => initPrimaryNav();
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", run, { once: true });
	} else {
		run();
	}

	document.addEventListener("astro:page-load", run);
</script>

<style>
	.nav {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
	}

	.nav__toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-xs);
		min-height: var(--control-height);
		padding: 0 var(--space-md);
	}

	.nav__toggle.btn {
		box-shadow: none;
		border: 1px solid transparent;
		padding: 0 var(--space-md);
		min-height: var(--control-height);
	}

	.nav__menu {
		display: none;
		align-items: center;
		gap: var(--space-sm);
		flex-wrap: nowrap;
	}

	.nav[data-open="true"] .nav__menu {
		display: flex;
	}

	.nav__toggleIcon {
		display: block;
	}

	.nav__toggleIcon--close {
		display: none;
	}

	.nav__toggle[aria-expanded="true"] .nav__toggleIcon--menu {
		display: none;
	}

	.nav__toggle[aria-expanded="true"] .nav__toggleIcon--close {
		display: block;
	}

	.nav__link {
		display: inline-flex;
		align-items: center;
		min-height: var(--control-height);
		color: var(--color-text);
		text-decoration: none;
		padding: 0 var(--space-md);
		border-radius: var(--radius-md);
		position: relative;
		flex: 0 0 auto;
		white-space: nowrap;
		transition: color 160ms ease;
	}

	.nav__bookNow.btn {
		background: transparent;
		border: 1px solid var(--color-border);
		box-shadow: none;
		white-space: nowrap;
		border-radius: var(--radius-sm);
		padding: 0 var(--space-md);
		font-weight: 400;
		gap: 0.6rem;
	}

	.nav__bookNow.btn:hover {
		background: var(--color-surface-muted);
		color: var(--color-primary);
	}

	.nav__bookNow .nav__externalIcon {
		opacity: 1;
		transform: none;
		pointer-events: none;
	}

	/* Refined underline: animates in smoothly on hover + focus-visible */
	.nav__link::after {
		content: "";
		position: absolute;
		left: var(--space-md);
		right: var(--space-md);
		bottom: 0.45rem;
		height: var(--stroke-1);
		border-radius: 9999px;
		background: color-mix(in oklab, var(--color-primary) 65%, transparent);
		opacity: 0;
		transform: scaleX(0.6);
		transform-origin: center;
		transition:
			opacity 160ms ease,
			transform 180ms ease,
			background-color 160ms ease;
	}

	.nav__link:hover,
	.nav__link:focus-visible {
		color: var(--color-primary);
	}

	.nav__link:hover::after,
	.nav__link:focus-visible::after {
		opacity: 1;
		transform: scaleX(1);
	}

	/* Subtle current-section treatment (no pill backgrounds). */
	.nav__link[aria-current="location"],
	.nav__link[aria-current="page"] {
		color: var(--color-primary);
	}

	.nav__link[aria-current="location"]::after,
	.nav__link[aria-current="page"]::after {
		opacity: 1;
		transform: scaleX(1);
	}

	/* External-link affordance */
	.nav__link--external {
		gap: 0.75rem;
	}

	.nav__externalIcon {
		opacity: 0;
		transform: translateY(1px);
		pointer-events: none;
		flex: 0 0 auto;
	}

	@media (prefers-reduced-motion: no-preference) {
		.nav__externalIcon {
			transition:
				opacity 140ms ease,
				transform 140ms ease;
		}
	}

	.nav__link--external:hover .nav__externalIcon,
	.nav__link--external:focus-visible .nav__externalIcon {
		opacity: 1;
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.nav__link::after {
			transition: none;
		}
		.nav__externalIcon {
			transition: none;
			transform: none;
		}
	}

	.nav__divider {
		width: 100%;
		height: 1px;
		background: var(--color-border);
		margin: var(--space-xs) 0;
	}

	.nav__settings {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-sm);
	}

	/* Mobile: toggle reveals vertical menu */
	@media (max-width: 48rem) {
		.nav {
			position: relative;
		}

		.nav__menu {
			position: absolute;
			top: calc(100% + var(--space-sm));
			right: 0;
			flex-direction: column;
			align-items: flex-start;
			width: max-content;
			max-width: calc(100vw - (var(--container-pad) * 2));
			padding: var(--space-sm);
			background: var(--color-surface);
			border: 1px solid var(--color-border);
			border-radius: var(--radius-lg);
			box-shadow: var(--shadow-md);
		}

		.nav__link {
			width: 100%;
			justify-content: flex-start;
		}

		/* No animated underline inside the dropdown panel */
		.nav__link::after {
			display: none;
		}

		/* Always show external-link icon on mobile (no hover) */
		.nav__externalIcon {
			opacity: 1;
			transform: none;
		}

		/* Let toggles size naturally (so panel sizes to longest item) */
		.nav__menu .lang-toggle--mobile {
			width: auto;
		}

		.nav__menu .lang-toggle--mobile .lang-toggle__link {
			flex: 0 0 auto;
		}
	}

	/* Desktop: menu always visible, toggle hidden */
	@media (min-width: 48.001rem) {
		.nav__toggle {
			display: none;
		}

		/* Desktop uses the SettingsMenu; keep inline toggles mobile-only */
		.nav__divider,
		.nav__settings {
			display: none;
		}

		.nav__menu {
			display: flex;
			position: static;
			padding: 0;
			border: 0;
			background: transparent;
		}
	}
</style>
