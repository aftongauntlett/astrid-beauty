---
import Button from "../ui/Button.astro";
import { Moon, Sun } from "@lucide/astro";

export interface Props {
	label?: string;
}

const { label = "Toggle theme" } = Astro.props;
---

<Button
	type="button"
	variant="ghost"
	size="sm"
	class="theme-toggle"
	aria-label={label}
	aria-pressed="false"
	data-theme-toggle
>
	<span class="sr-only">{label}</span>
	<Sun class="theme-toggle__icon" size={18} aria-hidden="true" focusable="false" data-icon="sun" />
	<Moon class="theme-toggle__icon" size={18} aria-hidden="true" focusable="false" data-icon="moon" />
</Button>

<script>
	import { toggleTheme } from "../../lib/theme";

	const button = document.querySelector("[data-theme-toggle]");
	if (button instanceof HTMLButtonElement) {
		const syncPressed = () => {
			const theme = document.documentElement.dataset["theme"];
			button.setAttribute("aria-pressed", theme === "dark" ? "true" : "false");
		};

		syncPressed();

		button.addEventListener("click", () => {
			toggleTheme();
			syncPressed();
		});
	}
</script>

<style is:global>
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-xs);
		width: var(--control-height);
		padding: 0;
		border-radius: var(--radius-md);
		box-shadow: none;
	}

	.theme-toggle.btn {
		min-height: var(--control-height);
		border: 1px solid transparent;
		background: transparent;
		box-shadow: none;
	}

	.theme-toggle__icon {
		display: block;
	}

	html[data-theme="dark"] .theme-toggle [data-icon="sun"] {
		display: none;
	}

	html[data-theme="light"] .theme-toggle [data-icon="moon"] {
		display: none;
	}
</style>
