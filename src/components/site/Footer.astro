---
const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
	<div class="container site-footer__inner">
		<div class="site-footer__grid">
			<section class="site-footer__block" aria-label="Address">
				<h2 class="site-footer__heading">Address</h2>
				<p class="site-footer__text">Placeholder address</p>
			</section>

			<section class="site-footer__block" aria-label="Phone">
				<h2 class="site-footer__heading">Phone</h2>
				<p class="site-footer__text">Placeholder phone</p>
			</section>

			<section class="site-footer__block" aria-label="Hours">
				<h2 class="site-footer__heading">Hours</h2>
				<p class="site-footer__text">Placeholder hours</p>
			</section>

			<section class="site-footer__block" aria-label="Social links">
				<h2 class="site-footer__heading">Social</h2>
				<ul class="site-footer__list">
					<li><a class="site-footer__link" href="/">Placeholder</a></li>
					<li><a class="site-footer__link" href="/">Placeholder</a></li>
				</ul>
			</section>
		</div>

		<small class="site-footer__meta">&copy; {year} Site</small>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--color-surface-muted);
		border-top: 1px solid var(--color-border);
		padding-block: var(--space-xl);
	}

	.site-footer__inner {
		display: grid;
		gap: var(--space-lg);
	}

	.site-footer__grid {
		display: grid;
		gap: var(--space-lg);
	}

	.site-footer__heading {
		font-size: 1rem;
		margin: 0 0 var(--space-xs);
	}

	.site-footer__text {
		margin: 0;
		color: var(--color-text-muted);
	}

	.site-footer__list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: var(--space-xs);
	}

	.site-footer__link {
		color: var(--color-text);
	}

	.site-footer__link:hover {
		color: var(--color-primary);
	}

	.site-footer__meta {
		color: var(--color-text-muted);
	}

	@media (min-width: 48rem) {
		.site-footer__grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
</style>
