---
import { getMessages, type Lang } from "../../i18n";

export interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const messages = getMessages(lang);

const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
	<div class="container site-footer__inner">
		<div class="site-footer__grid">
			<section class="site-footer__block" aria-label={messages.footer.address}>
				<h2 class="site-footer__heading">{messages.footer.address}</h2>
				<p class="site-footer__text">{messages.footer.placeholderAddress}</p>
			</section>

			<section class="site-footer__block" aria-label={messages.footer.phone}>
				<h2 class="site-footer__heading">{messages.footer.phone}</h2>
				<p class="site-footer__text">{messages.footer.placeholderPhone}</p>
			</section>

			<section class="site-footer__block" aria-label={messages.footer.hours}>
				<h2 class="site-footer__heading">{messages.footer.hours}</h2>
				<p class="site-footer__text">{messages.footer.placeholderHours}</p>
			</section>

			<section class="site-footer__block" aria-label={messages.footer.social}>
				<h2 class="site-footer__heading">{messages.footer.social}</h2>
				<ul class="site-footer__list">
					<li><a class="site-footer__link" href="/">{messages.footer.placeholderSocial}</a></li>
					<li><a class="site-footer__link" href="/">{messages.footer.placeholderSocial}</a></li>
				</ul>
			</section>
		</div>

		<small class="site-footer__meta">&copy; {year} {messages.footer.copyright}</small>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--color-surface-muted);
		border-top: 1px solid var(--color-border);
		padding-block: var(--space-xl);
	}

	.site-footer__inner {
		display: grid;
		gap: var(--space-xl);
	}

	.site-footer__grid {
		display: grid;
		gap: var(--space-lg);
	}

	.site-footer__heading {
		font-size: var(--text-sm);
		margin: 0 0 var(--space-xs);
		letter-spacing: 0.01em;
		text-transform: none;
	}

	.site-footer__text {
		margin: 0;
		color: var(--color-text-muted);
	}

	.site-footer__list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: var(--space-xs);
	}

	.site-footer__link {
		color: var(--color-text);
	}

	.site-footer__link:hover {
		color: var(--color-primary);
	}

	.site-footer__meta {
		color: var(--color-text-muted);
		padding-top: var(--space-lg);
		border-top: 1px solid var(--color-border);
	}

	@media (min-width: 36rem) {
		.site-footer__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 48rem) {
		.site-footer__grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
</style>
