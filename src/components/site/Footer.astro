---
import { getMessages, type Lang } from "../../i18n";
import {
	getAddressData,
	getDisplayHours,
	getMapsLinks,
	getPhoneHref,
} from "../../lib/footer/formatting";

import FooterAddress from "./footer/FooterAddress.astro";
import FooterContact from "./footer/FooterContact.astro";
import FooterHours from "./footer/FooterHours.astro";
import FooterMeta from "./footer/FooterMeta.astro";

import "./footer/FooterShared.module.css";

export interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const messages = getMessages(lang);

const contactEmail = "byastridm@gmail.com";

const { addressDisplayLines, fullAddress } = getAddressData(messages.footer.placeholderAddress);
const { googleMapsHref, appleMapsHref } = getMapsLinks(fullAddress);
const displayHours = getDisplayHours(messages.footer.placeholderHours);
const phoneHref = getPhoneHref(messages.footer.placeholderPhone);

const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
	<div class="container site-footer__inner">
		<div class="site-footer__grid">
			<FooterAddress
				messages={messages}
				addressDisplayLines={addressDisplayLines}
				googleMapsHref={googleMapsHref}
				appleMapsHref={appleMapsHref}
			/>

			<FooterContact messages={messages} phoneHref={phoneHref} contactEmail={contactEmail} />

			<div class="site-footer__mobileDivider" aria-hidden="true"></div>

			<FooterHours messages={messages} displayHours={displayHours} />
		</div>

		<FooterMeta messages={messages} year={year} />
	</div>
</footer>

<script>
	import { initFooter } from "../../scripts/footer";

	initFooter();
</script>
