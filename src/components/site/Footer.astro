---
import Button from "../ui/Button.astro";
import { ArrowUp, MapPin } from "@lucide/astro";
import { getMessages, type Lang } from "../../i18n";

export interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const messages = getMessages(lang);

const contactEmail = "byastridm@gmail.com";

const addressLines = messages.footer.placeholderAddress.split("\n").map((line) => line.trim()).filter(Boolean);

const firstAddressLine = addressLines[0] ?? "";
const [streetRaw, suiteRaw] = firstAddressLine.split(",").map((part) => part.trim());
const addressDisplayLines = [
	streetRaw,
	suiteRaw,
	...addressLines.slice(1),
]
	.map((line) => line?.trim())
	.filter(Boolean);

const fullAddress = addressDisplayLines.join(", ");
const mapsQuery = encodeURIComponent(fullAddress);
const googleMapsHref = `https://www.google.com/maps/search/?api=1&query=${mapsQuery}`;
const appleMapsHref = `https://maps.apple.com/?q=${mapsQuery}`;

const hoursLines = messages.footer.placeholderHours.split("\n").map((line) => line.trim()).filter(Boolean);
const dayLines = hoursLines.slice(1);

const stripMeridiem = (value: string) =>
	value
		.replace(/\s*(a\.?m\.?|p\.?m\.?|am|pm)\b/gi, "")
		.replace(/\s{2,}/g, " ")
		.trim();

const hours = dayLines
	.map((line) => {
		const idx = line.indexOf(":");
		if (idx === -1) return null;
		const day = line.slice(0, idx).trim();
		const time = stripMeridiem(line.slice(idx + 1).trim());
		return { day, time };
	})
	.filter(Boolean) as Array<{ day: string; time: string }>;

const isClosedTime = (value: string) => /^(closed|cerrado)$/i.test(value.trim());

const abbreviateDay = (value: string) => {
	const normalized = value
		.normalize("NFD")
		.replace(/[\u0300-\u036f]/g, "")
		.replace(/\./g, "")
		.trim()
		.toLowerCase();

	// English
	if (normalized === "monday") return "Mon";
	if (normalized === "tuesday") return "Tues";
	if (normalized === "wednesday") return "Weds";
	if (normalized === "thursday") return "Thurs";
	if (normalized === "friday") return "Fri";
	if (normalized === "saturday") return "Sat";
	if (normalized === "sunday") return "Sun";

	// Spanish
	if (normalized === "lunes") return "Lun";
	if (normalized === "martes") return "Mar";
	if (normalized === "miercoles") return "Mie";
	if (normalized === "jueves") return "Jue";
	if (normalized === "viernes") return "Vie";
	if (normalized === "sabado") return "Sab";
	if (normalized === "domingo") return "Dom";

	// Already abbreviated or unknown format.
	return value;
};

const closedDays = hours.filter((item) => isClosedTime(item.time)).map((item) => abbreviateDay(item.day));
const closedLabel = hours.find((item) => isClosedTime(item.time))?.time;

const openGroups = new Map<string, { days: string[]; firstIndex: number }>();
const openTimesInOrder: string[] = [];

for (const [index, item] of hours.entries()) {
	if (isClosedTime(item.time)) continue;
	const time = item.time;
	const day = abbreviateDay(item.day);
	const existing = openGroups.get(time);
	if (!existing) {
		openGroups.set(time, { days: [day], firstIndex: index });
		openTimesInOrder.push(time);
		continue;
	}

	existing.days.push(day);
}

const displayHours = openTimesInOrder.map((time) => {
	const group = openGroups.get(time);
	if (!group) return { day: "", time };
	return { day: group.days.join(", "), time };
});

if (closedDays.length > 0) {
	displayHours.push({ day: closedDays.join(", "), time: closedLabel ?? "Closed" });
}

const phoneDigits = messages.footer.placeholderPhone.replace(/\D/g, "");
const phoneHref = phoneDigits.length === 10 ? `tel:+1${phoneDigits}` : `tel:+${phoneDigits}`;

const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
	<div class="container site-footer__inner">
		<div class="site-footer__grid">
			<section class="site-footer__block" aria-label={messages.footer.address}>
				<h2 class="sr-only">{messages.nav.findUs}</h2>
				<div class="site-footer__blockBody">
					<address class="site-footer__text" aria-label={messages.footer.address}>
						{addressDisplayLines.map((line) => (
							<span class="site-footer__line">{line}</span>
						))}
					</address>
				</div>
				<div class="site-footer__blockBottom">
					<Button
						class="site-footer__mapButton"
						variant="ghost"
						size="sm"
						href={googleMapsHref}
						data-apple-maps-href={appleMapsHref}
						target="_blank"
						rel="noopener noreferrer"
					>
						<MapPin class="site-footer__mapIcon" size={18} aria-hidden="true" focusable="false" />
						<span>{messages.footer.findUsCta}</span>
					</Button>
				</div>
			</section>

			<section class="site-footer__block site-footer__block--contact" aria-label={messages.footer.contact}>
				<div class="site-footer__mobileDivider" aria-hidden="true"></div>
				<h2 class="sr-only">{messages.footer.contact}</h2>
				<div class="site-footer__contact">
					<div class="site-footer__blockBody">
						<div class="site-footer__contactLinks">
							<a class="site-footer__link" href={phoneHref}>{messages.footer.placeholderPhone}</a>
							<a class="site-footer__link" href={`mailto:${contactEmail}`}>{contactEmail}</a>
						</div>
					</div>
					<div class="site-footer__blockBottom">
						<div class="site-footer__socialRow" aria-label={messages.footer.social}>
						<a
							class="site-footer__iconLink"
							href="https://www.facebook.com/hair.by.astridm"
							target="_blank"
							rel="noopener noreferrer"
							aria-label={messages.footer.facebook}
							title={messages.footer.facebook}
						>
							<span class="site-footer__particle site-footer__particle1" aria-hidden="true"></span>
							<span class="site-footer__particle site-footer__particle2" aria-hidden="true"></span>
							<span class="site-footer__particle site-footer__particle3" aria-hidden="true"></span>
						<svg
							class="site-footer__iconSvg"
							role="img"
							viewBox="0 0 24 24"
							xmlns="http://www.w3.org/2000/svg"
							aria-hidden="true"
							focusable="false"
							fill="currentColor"
						>
							<path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z" />
						</svg>
						<span class="sr-only">{messages.footer.facebook}</span>
						</a>
						<a
							class="site-footer__iconLink"
							href="https://www.instagram.com/byastrid.beautysalon/"
							target="_blank"
							rel="noopener noreferrer"
							aria-label={messages.footer.instagram}
							title={messages.footer.instagram}
						>
							<span class="site-footer__particle site-footer__particle1" aria-hidden="true"></span>
							<span class="site-footer__particle site-footer__particle2" aria-hidden="true"></span>
							<span class="site-footer__particle site-footer__particle3" aria-hidden="true"></span>
						<svg
							class="site-footer__iconSvg"
							role="img"
							viewBox="0 0 24 24"
							xmlns="http://www.w3.org/2000/svg"
							aria-hidden="true"
							focusable="false"
							fill="currentColor"
						>
							<path d="M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077" />
						</svg>
						<span class="sr-only">{messages.footer.instagram}</span>
						</a>
						</div>
					</div>
				</div>
			</section>

			<div class="site-footer__mobileDivider" aria-hidden="true"></div>

			<section class="site-footer__block site-footer__block--hours" aria-label={messages.footer.hours}>
				<h2 class="sr-only">{messages.footer.hours}</h2>
				<table class="site-footer__hoursTable" aria-label={messages.footer.hours}>
					<tbody>
						{displayHours.map((item) => (
							<tr class="site-footer__hoursRow">
								<th class:list={["site-footer__hoursDay", item.day.includes(",") ? "site-footer__hoursDay--wrap" : ""]} scope="row">{item.day}:</th>
								<td class="site-footer__hoursTime">{item.time}</td>
							</tr>
						))}
					</tbody>
				</table>
			</section>
		</div>

		<div class="site-footer__mobileDivider" aria-hidden="true"></div>

		<div class="site-footer__meta">
			<div class="site-footer__metaLeft">
				<small class="site-footer__metaText site-footer__metaBuiltBy">
					{messages.footer.builtByLabel}{" "}
					<a class="site-footer__link" href="https://www.aftongauntlett.com/" target="_blank" rel="noopener noreferrer">AG</a>
				</small>
				<small class="site-footer__metaText site-footer__metaCopyright">&copy; {year} {messages.footer.copyright}</small>
			</div>
			<Button
				class="site-footer__toTop"
				variant="ghost"
				size="sm"
				href="#top"
				aria-label={messages.misc.backToTop}
				title={messages.misc.backToTop}
			>
				<ArrowUp size={16} aria-hidden="true" focusable="false" />
				<span class="sr-only">{messages.misc.backToTop}</span>
			</Button>
		</div>
	</div>
</footer>

<script>
	/** @type {typeof globalThis & { __astrid_footerController?: AbortController }} */
	const g = globalThis;

	g.__astrid_footerController?.abort?.();
	const controller = new AbortController();
	g.__astrid_footerController = controller;
	const { signal } = controller;

	document.addEventListener("astro:before-swap", () => controller.abort(), { once: true, signal });

	// Prefer Apple Maps on Apple devices.
	const link = document.querySelector("[data-apple-maps-href]");
	if (link instanceof HTMLAnchorElement) {
		try {
			const isApple = /iPhone|iPad|iPod|Macintosh/.test(navigator.userAgent);
			if (isApple) {
				const appleHref = link.getAttribute("data-apple-maps-href");
				if (appleHref) link.href = appleHref;
			}
		} catch {
			// ignore
		}
	}

	// Smooth-scroll back to top.
	const toTop = document.querySelector(".site-footer__toTop");
	if (toTop instanceof HTMLAnchorElement) {
		toTop.addEventListener(
			"click",
			(event) => {
			try {
				event.preventDefault();
				const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches;
				window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
				const url = new URL(window.location.href);
				url.hash = "#top";
				history.pushState({}, "", url);
			} catch {
				// ignore
			}
			},
			{ signal }
		);
	}
</script>

<style>
	.site-footer {
		background: var(--color-surface-muted);
		padding-block: var(--space-md);
		box-shadow: inset 0 1px 0 var(--color-border);
	}

	.site-footer__inner {
		display: grid;
		gap: var(--space-md);
	}

	.site-footer__grid {
		display: grid;
		gap: var(--space-md);
	}

	/* Mobile-first: stacked blocks centered for nicer rhythm */
	.site-footer__block {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-xs);
	}

	.site-footer__blockBody {
		width: 100%;
	}

	.site-footer__blockBottom {
		margin-top: auto;
		padding-top: var(--space-sm);
		display: flex;
		justify-content: center;
		width: 100%;
	}

	.site-footer__title {
		margin: 0 0 var(--space-sm);
		font-size: var(--text-sm);
		letter-spacing: 0.01em;
		color: var(--color-primary);
		font-weight: 700;
		text-transform: none;
	}

	.site-footer__text {
		margin: 0;
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}

	address.site-footer__text {
		font-style: normal;
	}

	.site-footer__line {
		display: block;
	}

	.site-footer__mapButton.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		justify-content: center;
		white-space: nowrap;
		background: transparent;
		border: 1px solid var(--color-border);
		box-shadow: none;
		color: var(--color-text);
		font-size: var(--text-sm);
		font-weight: 600;
		border-radius: var(--radius-sm);
		padding: 0 var(--space-md);
	}

	.site-footer__mapButton.btn:hover {
		color: var(--color-primary);
		background: var(--color-surface);
	}

	.site-footer__mapIcon {
		opacity: 0.9;
	}

	.site-footer__contact {
		display: grid;
		gap: var(--space-md);
	}

	.site-footer__contactLinks {
		display: grid;
		gap: var(--space-xs);
		justify-items: center;
		font-size: var(--text-sm);
	}

	.site-footer__contactLinks .site-footer__link {
		font-size: var(--text-sm);
		font-weight: 400;
	}

	.site-footer__note {
		margin: 0 0 var(--space-sm);
		color: var(--color-text-muted);
		font-size: var(--text-xs);
	}

	.site-footer__list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: var(--space-xs);
	}

	.site-footer__socialRow {
		margin-top: var(--space-xs);
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		justify-content: center;
		flex-wrap: wrap;
	}

	.site-footer__mobileDivider {
		height: 1px;
		width: 100%;
		justify-self: stretch;
		background: var(--color-border);
		margin-block: var(--space-sm);
		opacity: 0.9;
	}

	@media (max-width: 47.999rem) {
		.site-footer__block--hours {
			padding-top: var(--space-sm);
		}
	}

	@media (min-width: 48rem) {
		.site-footer__mobileDivider {
			display: none;
		}
	}

	.site-footer__iconLink {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 3.15rem;
		height: 3.15rem;
		border-radius: 999px;
		position: relative;
		background: linear-gradient(
			180deg,
			color-mix(in oklab, var(--color-surface) 82%, rgba(255, 255, 255, 0.06)) 0%,
			rgba(255, 255, 255, 0.03) 85%
		);
		color: var(--color-text);
		text-decoration: none;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.06),
			var(--shadow-sm);
		overflow: visible;
		transform-style: preserve-3d;
	}

	.site-footer__iconLink::before,
	.site-footer__iconLink::after {
		content: "";
		position: absolute;
		inset: -55%;
		border-radius: 999px;
		pointer-events: none;
		opacity: 0;
		background: radial-gradient(
			circle,
			color-mix(in oklab, var(--color-primary) 40%, transparent) 0%,
			transparent 65%
		);
		transition: opacity var(--motion-duration-fast) var(--motion-ease-standard);
	}

	.site-footer__iconLink::before {
		filter: blur(10px);
	}

	.site-footer__iconLink::after {
		background: radial-gradient(
			circle,
			color-mix(in oklab, var(--color-primary) 60%, transparent) 0%,
			transparent 70%
		);
		filter: blur(18px);
	}

	@media (prefers-reduced-motion: no-preference) {
		.site-footer__iconLink {
			transition:
				transform var(--motion-duration-fast) var(--motion-ease-standard),
				box-shadow var(--motion-duration-fast) var(--motion-ease-standard),
				color var(--motion-duration-fast) var(--motion-ease-standard);
		}

		.site-footer__iconSvg {
			transition: transform var(--motion-duration-fast) var(--motion-ease-standard);
		}
	}

	.site-footer__iconLink:hover {
		color: var(--color-primary);
		transform: translateY(-2px);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.06),
			var(--shadow-md);
	}

	@media (prefers-reduced-motion: no-preference) {
		.site-footer__iconLink:hover::before {
			opacity: 0.55;
			animation: site-footer__glowRadial 1.4s ease-in-out infinite;
		}

		.site-footer__iconLink:hover::after {
			opacity: 0.45;
			animation: site-footer__glowBlur 1.8s ease-in-out infinite;
		}

		.site-footer__iconLink:hover .site-footer__iconSvg {
			animation: site-footer__iconWobble 0.85s ease-in-out 1;
		}
	}

	@keyframes site-footer__glowRadial {
		0% {
			opacity: 0.12;
		}
		50% {
			opacity: 0.55;
		}
		100% {
			opacity: 0.18;
		}
	}

	@keyframes site-footer__glowBlur {
		0% {
			opacity: 0.08;
		}
		50% {
			opacity: 0.45;
		}
		100% {
			opacity: 0.12;
		}
	}

	@keyframes site-footer__iconWobble {
		0% {
			transform: translateY(0) rotate(0deg) scale(1);
		}
		35% {
			transform: translateY(0) rotate(-6deg) scale(1.03);
		}
		70% {
			transform: translateY(0) rotate(6deg) scale(1.03);
		}
		100% {
			transform: translateY(0) rotate(0deg) scale(1);
		}
	}

	.site-footer__particle {
		position: absolute;
		z-index: 2;
		width: 0.35rem;
		height: 0.35rem;
		border-radius: 999px;
		background: color-mix(in oklab, var(--color-primary) 70%, transparent);
		pointer-events: none;
		opacity: 0;
		transform: translate3d(0, 0, 0);
	}

	.site-footer__particle1 {
		left: 62%;
		top: 18%;
	}

	.site-footer__particle2 {
		left: 22%;
		top: 58%;
	}

	.site-footer__particle3 {
		left: 78%;
		top: 64%;
	}

	@media (prefers-reduced-motion: no-preference) {
		.site-footer__iconLink:hover .site-footer__particle {
			animation: site-footer__particleFloat 1.6s ease-in-out infinite;
		}

		.site-footer__iconLink:hover .site-footer__particle1 {
			animation-delay: 0s;
		}

		.site-footer__iconLink:hover .site-footer__particle2 {
			animation-delay: 0.45s;
		}

		.site-footer__iconLink:hover .site-footer__particle3 {
			animation-delay: 0.9s;
		}
	}

	@keyframes site-footer__particleFloat {
		0% {
			opacity: 0;
			transform: translate3d(0, 0, 0) scale(0);
		}
		25% {
			opacity: 1;
			transform: translate3d(0, -18px, 0) scale(1);
		}
		100% {
			opacity: 0;
			transform: translate3d(4px, -64px, 0) scale(0);
		}
