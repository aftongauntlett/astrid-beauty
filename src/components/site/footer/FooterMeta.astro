---
import Button from "../../ui/Button.astro";
import { ArrowUp } from "@lucide/astro";

import "./FooterMeta.module.css";

import type { Messages } from "../../../i18n/types";

export type Props = {
	messages: Messages;
	year: number;
};

const { messages, year } = Astro.props;
---

<div class="site-footer__mobileDivider" aria-hidden="true"></div>

<div class="site-footer__meta">
	<div class="site-footer__metaLeft">
		<small class="site-footer__metaText site-footer__metaBuiltBy">
			{messages.footer.builtByLabel}{" "}
			<a class="site-footer__link" href="https://www.aftongauntlett.com/" target="_blank" rel="noopener noreferrer">AG</a>
		</small>
		<small class="site-footer__metaText site-footer__metaCopyright">&copy; {year} {messages.footer.copyright}</small>
	</div>
	<Button
		class="site-footer__toTop"
		variant="ghost"
		size="sm"
		href="#top"
		aria-label={messages.misc.backToTop}
		title={messages.misc.backToTop}
	>
		<ArrowUp size={16} aria-hidden="true" focusable="false" />
		<span class="sr-only">{messages.misc.backToTop}</span>
	</Button>
</div>
