---
import Nav from './Nav.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header" role="banner">
	<div class="container site-header__inner">
		<a class="site-header__brand" href="/" aria-label="By Astrid Beauty home">
			<img
				class="site-header__brandLogo"
				src="/by-astrid-beauty-logo-nav.png"
				alt="By Astrid Beauty"
				width="845"
				height="328"
				decoding="async"
			/>
		</a>
		<div class="site-header__right">
			<Nav />
			<ThemeToggle />
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-lg);
		min-height: var(--header-height);
		padding-block: var(--space-xs);
	}

	.site-header__right {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: var(--space-md);
		min-width: 0;
	}

	.site-header__brand {
		color: var(--color-text);
		text-decoration: none;
		padding: var(--space-xs) var(--space-sm);
		border-radius: var(--radius-md);
		font-weight: 700;
		display: inline-flex;
		align-items: center;
		flex: 0 0 auto;
	}

	.site-header__brandLogo {
		display: block;
		height: clamp(2.25rem, 2.7vw, 3rem);
		max-height: calc(var(--header-height) - var(--space-sm));
		width: auto;
	}

	.site-header__brand:hover {
		color: var(--color-primary);
	}
</style>
