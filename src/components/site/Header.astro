---
import Nav from './Nav.astro';

import { getMessages, type Lang } from "../../i18n";

export interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const messages = getMessages(lang);

const homeHref = lang === "es" ? "/es" : "/";
---

<header class="site-header" role="banner">
	<div class="container site-header__inner">
		<a
			class="site-header__brand"
			href={homeHref}
			aria-label={messages.home.brandSrOnly}
		>
			<span class="site-header__brandText">
				<span class="site-header__brandScript">by Astrid</span>
				<span class="site-header__brandSalon">Beauty Salon</span>
			</span>
		</a>
		<div class="site-header__right">
			<Nav lang={lang} />
		</div>
	</div>
</header>

<script>
	const initHeaderAutoHide = () => {
		const header = document.querySelector(".site-header");
		if (!(header instanceof HTMLElement)) return;

		const isSmallScreen =
			window.matchMedia?.("(max-width: 48rem)").matches ?? false;
		if (isSmallScreen) {
			header.dataset["hidden"] = "false";
			return;
		}

		globalThis.__astrid_headerAutoHideController?.abort?.();
		const controller = new AbortController();
		globalThis.__astrid_headerAutoHideController = controller;
		const { signal } = controller;

		document.addEventListener("astro:before-swap", () => controller.abort(), { once: true, signal });

		const about = document.getElementById("about");
		if (!(about instanceof HTMLElement)) return;

		let lastScrollY = window.scrollY;
		let hidden = false;
		let headerHeight = 0;
		let triggerScrollY = Number.POSITIVE_INFINITY;
		const hideTriggerOffset = 24;
		const showTriggerOffset = 8;
		let prefersReducedMotion =
			window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false;
		const reducedMotionMql = window.matchMedia?.("(prefers-reduced-motion: reduce)");

		const recalcMetrics = () => {
			headerHeight = Math.ceil(header.getBoundingClientRect().height);
			const aboutTopAbs = about.getBoundingClientRect().top + window.scrollY;
			triggerScrollY = Math.max(0, aboutTopAbs - (headerHeight + 8));
		};

		let raf = 0;
		signal.addEventListener("abort", () => {
			if (raf) cancelAnimationFrame(raf);
			raf = 0;
		});

		const computeHidden = () => {
			raf = 0;
			if (prefersReducedMotion) {
				hidden = false;
				header.dataset["hidden"] = "false";
				return;
			}

			const nav = header.querySelector("nav[data-primary-nav]");
			const navOpen = nav instanceof HTMLElement && nav.dataset["open"] === "true";
			if (navOpen) {
				header.dataset["hidden"] = "false";
				hidden = false;
				return;
			}

			const currentY = window.scrollY;
			const delta = currentY - lastScrollY;
			lastScrollY = currentY;

			const hideTriggerY = triggerScrollY + hideTriggerOffset;
			const showTriggerY = triggerScrollY + showTriggerOffset;

			if (!hidden && currentY < hideTriggerY) {
				hidden = false;
				header.dataset["hidden"] = "false";
				return;
			}

			if (hidden && currentY <= showTriggerY) {
				hidden = false;
				header.dataset["hidden"] = "false";
				return;
			}

			const isScrollingDown = delta > 3;
			const isScrollingUp = delta < -3;

			if (isScrollingUp) {
				hidden = false;
				header.dataset["hidden"] = "false";
				return;
			}

			if (isScrollingDown || !hidden) {
				hidden = true;
				header.dataset["hidden"] = "true";
				return;
			}

			header.dataset["hidden"] = "true";
		};

		const schedule = () => {
			if (raf) return;
			raf = requestAnimationFrame(computeHidden);
		};

		recalcMetrics();
		computeHidden();
		reducedMotionMql?.addEventListener(
			"change",
			(event) => {
				prefersReducedMotion = event.matches;
				schedule();
			},
			{ signal }
		);
		window.addEventListener("scroll", schedule, { passive: true, signal });
		window.addEventListener(
			"resize",
			() => {
				recalcMetrics();
				schedule();
			},
			{ signal }
		);
		document.addEventListener("click", schedule, { signal });
		document.addEventListener("keydown", schedule, { signal });
	};

	const run = () => initHeaderAutoHide();
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", run, { once: true });
	} else {
		run();
	}

	document.addEventListener("astro:page-load", run);
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--color-surface-muted);
		border-bottom: 1px solid var(--color-divider);
		transform: translateY(0);
		isolation: isolate;
	}

	html:not([data-theme="dark"]) .site-header {
		background: var(--surface-glass-muted);
		border-bottom-color: color-mix(in oklab, var(--color-border) 90%, transparent);
		box-shadow:
			0 22px 60px -48px var(--shadow-color-md),
			inset 0 1px 0 var(--glass-highlight),
			inset 0 -1px 0 color-mix(in oklab, var(--color-primary) 10%, transparent);
	}

	/* Light mode: add a subtle “edge” line for separation */
	html:not([data-theme="dark"]) .site-header::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 1px;
		background: linear-gradient(
			90deg,
			transparent,
			color-mix(in oklab, var(--color-secondary) 58%, transparent),
			transparent
		);
		opacity: 0.65;
		pointer-events: none;
		z-index: 1;
	}

	@media (min-width: 48rem) {
		@supports (backdrop-filter: blur(1px)) {
			html:not([data-dev-mode="true"]) .site-header {
				backdrop-filter: blur(16px) saturate(1.08);
				-webkit-backdrop-filter: blur(16px) saturate(1.08);
			}
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.site-header {
			transition: transform var(--motion-duration-normal) var(--motion-ease-standard), opacity var(--motion-duration-normal) var(--motion-ease-standard);
		}
	}

	.site-header[data-hidden="true"] {
		transform: translateY(-110%);
		opacity: 0;
		pointer-events: none;
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-lg);
		min-height: var(--header-height);
		padding-block: var(--space-xs);
	}

	.site-header__right {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: var(--space-md);
		min-width: 0;
	}

	.site-header__brand {
		color: var(--color-text);
		text-decoration: none;
		padding: var(--space-xs) var(--space-sm);
		border-radius: 0;
		font-weight: 500;
		display: inline-flex;
		align-items: center;
		flex: 0 0 auto;
		background: transparent;
		border: 1px solid transparent;
		box-shadow: none;
	}

	/* Light mode: brand sits bare on the glass header */
	html:not([data-theme="dark"]) .site-header__brand {
		background: transparent;
		border-color: transparent;
		box-shadow: none;
	}

	/* Dark mode: no background, sits clean on header */
	html[data-theme="dark"] .site-header__brand {
		background: transparent;
		border-color: transparent;
		box-shadow: none;
	}

	.site-header__brandText {
		display: inline-grid;
		grid-auto-flow: row;
		gap: 0.06rem;
		font-size: clamp(1.02rem, 1.4vw, 1.28rem);
		font-weight: 500;
		letter-spacing: 0.01em;
		line-height: 1.05;
		white-space: nowrap;
	}

	.site-header__brandScript {
		font-family: var(--font-script);
		font-style: normal;
		font-weight: 400;
		font-size: 1.15em;
		line-height: 1;
		letter-spacing: 0.004em;
		color: color-mix(in oklab, var(--color-primary) 72%, var(--color-secondary));
	}

	.site-header__brandSalon {
		font-family: var(--font-heading);
		font-style: normal;
		font-weight: 500;
		font-size: 0.9em;
		padding-left: 0.42em;
		justify-self: start;
		color: color-mix(in oklab, var(--color-primary) 88%, var(--color-text-muted));
		transition: color var(--motion-duration-fast) var(--motion-ease-standard);
	}

	html[data-theme="dark"] .site-header__brandSalon {
		color: color-mix(in oklab, var(--color-text) 78%, var(--color-text-muted));
	}

	.site-header__brand:hover .site-header__brandSalon,
	.site-header__brand:focus-visible .site-header__brandSalon {
		color: var(--color-secondary);
	}

	/* Brand hover: gold underline matching nav links */
	.site-header__brand {
		position: relative;
	}

	.site-header__brand::after {
		content: "";
		position: absolute;
		left: var(--space-sm);
		right: var(--space-sm);
		bottom: 0.15rem;
		height: 2px;
		border-radius: 9999px;
		background: var(--color-secondary);
		opacity: 0;
		transform: scaleX(1);
		transform-origin: center;
	}

	.site-header__brand:hover::after,
	.site-header__brand:focus-visible::after {
		opacity: 1;
	}

	/* Light mode only: subtle darken on hover text */
	html:not([data-theme="dark"]) .site-header__brand:hover {
		opacity: 0.85;
	}

	/* Dark mode: no opacity change, just the underline */
	html[data-theme="dark"] .site-header__brand:hover {
		opacity: 1;
	}

	@media (prefers-reduced-motion: no-preference) {
		.site-header__brand {
			transition:
				opacity var(--motion-duration-fast) var(--motion-ease-standard);
		}
		.site-header__brand::after {
			transition:
				opacity var(--motion-duration-normal) var(--motion-ease-luxury);
		}
	}
</style>
