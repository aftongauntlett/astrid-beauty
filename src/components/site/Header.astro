---
import Nav from './Nav.astro';
import SettingsMenu from './SettingsMenu.astro';

import { getMessages, type Lang } from "../../i18n";

export interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const messages = getMessages(lang);

const homeHref = lang === "es" ? "/es" : "/";
---

<header class="site-header" role="banner">
	<div class="container site-header__inner">
		<a
			class="site-header__brand"
			href={homeHref}
			aria-label={messages.home.brandSrOnly}
		>
			<img
				class="site-header__brandLogo"
				src="/astrid-logo-nav.png"
				alt="By Astrid Beauty"
				width="845"
				height="328"
				decoding="async"
			/>
		</a>
		<div class="site-header__right">
			<Nav lang={lang} />
			<SettingsMenu lang={lang} mode="desktop" />
		</div>
	</div>
</header>

<script>
	const initHeaderAutoHide = () => {
		const header = document.querySelector(".site-header");
		if (!(header instanceof HTMLElement)) return;

		globalThis.__astrid_headerAutoHideController?.abort?.();
		const controller = new AbortController();
		globalThis.__astrid_headerAutoHideController = controller;
		const { signal } = controller;

		document.addEventListener("astro:before-swap", () => controller.abort(), { once: true, signal });

		const about = document.getElementById("about");
		if (!(about instanceof HTMLElement)) return;

		let lastScrollY = window.scrollY;
		let hidden = false;

		let raf = 0;
		signal.addEventListener("abort", () => {
			if (raf) cancelAnimationFrame(raf);
			raf = 0;
		});

		const computeHidden = () => {
			raf = 0;
			const nav = header.querySelector("nav[data-primary-nav]");
			const navOpen = nav instanceof HTMLElement && nav.dataset["open"] === "true";
			if (navOpen) {
				header.dataset["hidden"] = "false";
				hidden = false;
				return;
			}

			const currentY = window.scrollY;
			const delta = currentY - lastScrollY;
			lastScrollY = currentY;

			const headerHeight = header.getBoundingClientRect().height;
			const aboutTop = about.getBoundingClientRect().top;
			const pastTrigger = aboutTop <= headerHeight + 8;

			// Always show before hitting the trigger zone.
			if (!pastTrigger) {
				hidden = false;
				header.dataset["hidden"] = "false";
				return;
			}

			const isScrollingDown = delta > 2;
			const isScrollingUp = delta < -2;

			if (isScrollingUp) {
				hidden = false;
				header.dataset["hidden"] = "false";
				return;
			}

			if (isScrollingDown || !hidden) {
				hidden = true;
				header.dataset["hidden"] = "true";
				return;
			}

			header.dataset["hidden"] = "true";
		};

		const schedule = () => {
			if (raf) return;
			raf = requestAnimationFrame(computeHidden);
		};

		computeHidden();
		window.addEventListener("scroll", schedule, { passive: true, signal });
		window.addEventListener("resize", schedule, { signal });
		document.addEventListener("click", schedule, { signal });
		document.addEventListener("keydown", schedule, { signal });
	};

	const run = () => initHeaderAutoHide();
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", run, { once: true });
	} else {
		run();
	}

	document.addEventListener("astro:page-load", run);
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--color-surface-muted);
		border-bottom: 1px solid var(--color-divider);
		transform: translateY(0);
		isolation: isolate;
	}

	html:not([data-theme="dark"]) .site-header {
		background: var(--surface-glass-muted);
		border-bottom-color: color-mix(in oklab, var(--color-border) 90%, transparent);
		box-shadow:
			0 18px 46px -38px var(--shadow-color-md),
			inset 0 1px 0 var(--glass-highlight),
			inset 0 -1px 0 color-mix(in oklab, var(--color-primary) 10%, transparent);
	}

	/* Light mode: add a subtle “edge” line for separation */
	html:not([data-theme="dark"]) .site-header::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 1px;
		background: linear-gradient(
			90deg,
			transparent,
			color-mix(in oklab, var(--color-primary) 34%, transparent),
			transparent
		);
		opacity: 0.65;
		pointer-events: none;
		z-index: 1;
	}

	@supports (backdrop-filter: blur(1px)) {
		.site-header {
			backdrop-filter: blur(12px) saturate(1.06);
			-webkit-backdrop-filter: blur(12px) saturate(1.06);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.site-header {
			transition: transform var(--motion-duration-normal) var(--motion-ease-standard), opacity var(--motion-duration-normal) var(--motion-ease-standard);
		}
	}

	.site-header[data-hidden="true"] {
		transform: translateY(-110%);
		opacity: 0;
		pointer-events: none;
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-lg);
		min-height: var(--header-height);
		padding-block: var(--space-xs);
	}

	.site-header__right {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: var(--space-md);
		min-width: 0;
	}

	.site-header__brand {
		color: var(--color-text);
		text-decoration: none;
		padding: var(--space-xs) var(--space-sm);
		border-radius: var(--radius-md);
		font-weight: 700;
		display: inline-flex;
		align-items: center;
		flex: 0 0 auto;
		background: transparent;
		border: 1px solid transparent;
		box-shadow: none;
	}

	/* Light mode: give the gold logo a clean dark base */
	html:not([data-theme="dark"]) .site-header__brand {
		background: linear-gradient(180deg, #0b0b0c 0%, #0f0f10 100%);
		border-color: color-mix(in oklab, var(--color-secondary) 18%, transparent);
		box-shadow:
			0 16px 32px -26px var(--shadow-color-md),
			inset 0 1px 0 rgba(255, 255, 255, 0.08);
	}

	/* Dark mode: keep it subtle (header is already dark) */
	html[data-theme="dark"] .site-header__brand {
		background: color-mix(in oklab, var(--color-bg) 32%, transparent);
		border-color: color-mix(in oklab, var(--color-border) 70%, transparent);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
	}

	.site-header__brandLogo {
		display: block;
		height: clamp(2.25rem, 2.7vw, 3rem);
		max-height: calc(var(--header-height) - var(--space-sm));
		width: auto;
	}


	.site-header__brand:hover {
		transform: translateY(-1px);
		box-shadow:
			0 18px 36px -28px var(--shadow-color-md),
			inset 0 1px 0 rgba(255, 255, 255, 0.1);
	}

	@media (prefers-reduced-motion: no-preference) {
		.site-header__brand {
			transition:
				transform var(--motion-duration-fast) var(--motion-ease-standard),
				box-shadow var(--motion-duration-fast) var(--motion-ease-standard),
				background-color var(--motion-duration-fast) var(--motion-ease-standard),
				border-color var(--motion-duration-fast) var(--motion-ease-standard);
		}
	}
</style>
