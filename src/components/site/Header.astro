---
import Nav from './Nav.astro';
import SettingsMenu from './SettingsMenu.astro';

import { getMessages, type Lang } from "../../i18n";

export interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const messages = getMessages(lang);

const homeHref = lang === "es" ? "/es" : "/";
---

<header class="site-header" role="banner">
	<div class="container site-header__inner">
		<a
			class="site-header__brand"
			href={homeHref}
			aria-label={messages.home.brandSrOnly}
		>
			<img
				class="site-header__brandLogo"
				src="/by-astrid-beauty-logo-nav.png"
				alt="By Astrid Beauty"
				width="845"
				height="328"
				decoding="async"
			/>
		</a>
		<div class="site-header__right">
			<Nav lang={lang} />
			<SettingsMenu lang={lang} mode="desktop" />
		</div>
	</div>
</header>

<script>
	const initHeaderAutoHide = () => {
		const header = document.querySelector(".site-header");
		if (!(header instanceof HTMLElement)) return;

		globalThis.__astrid_headerAutoHideController?.abort?.();
		const controller = new AbortController();
		globalThis.__astrid_headerAutoHideController = controller;
		const { signal } = controller;

		document.addEventListener("astro:before-swap", () => controller.abort(), { once: true, signal });

		const about = document.getElementById("about");
		if (!(about instanceof HTMLElement)) return;

		let lastScrollY = window.scrollY;
		let hidden = false;

		let raf = 0;
		signal.addEventListener("abort", () => {
			if (raf) cancelAnimationFrame(raf);
			raf = 0;
		});

		const computeHidden = () => {
			raf = 0;
			const nav = header.querySelector("nav[data-primary-nav]");
			const navOpen = nav instanceof HTMLElement && nav.dataset["open"] === "true";
			if (navOpen) {
				header.dataset["hidden"] = "false";
				hidden = false;
				return;
			}

			const currentY = window.scrollY;
			const delta = currentY - lastScrollY;
			lastScrollY = currentY;

			const headerHeight = header.getBoundingClientRect().height;
			const aboutTop = about.getBoundingClientRect().top;
			const pastTrigger = aboutTop <= headerHeight + 8;

			// Always show before hitting the trigger zone.
			if (!pastTrigger) {
				hidden = false;
				header.dataset["hidden"] = "false";
				return;
			}

			const isScrollingDown = delta > 2;
			const isScrollingUp = delta < -2;

			if (isScrollingUp) {
				hidden = false;
				header.dataset["hidden"] = "false";
				return;
			}

			if (isScrollingDown || !hidden) {
				hidden = true;
				header.dataset["hidden"] = "true";
				return;
			}

			header.dataset["hidden"] = "true";
		};

		const schedule = () => {
			if (raf) return;
			raf = requestAnimationFrame(computeHidden);
		};

		computeHidden();
		window.addEventListener("scroll", schedule, { passive: true, signal });
		window.addEventListener("resize", schedule, { signal });
		document.addEventListener("click", schedule, { signal });
		document.addEventListener("keydown", schedule, { signal });
	};

	const run = () => initHeaderAutoHide();
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", run, { once: true });
	} else {
		run();
	}

	document.addEventListener("astro:page-load", run);
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--color-surface-muted);
		border-bottom: 1px solid var(--color-divider);
		transform: translateY(0);
	}

	@supports (backdrop-filter: blur(1px)) {
		.site-header {
			backdrop-filter: blur(12px) saturate(1.06);
			-webkit-backdrop-filter: blur(12px) saturate(1.06);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.site-header {
			transition: transform var(--motion-duration-normal) var(--motion-ease-standard), opacity var(--motion-duration-normal) var(--motion-ease-standard);
		}
	}

	.site-header[data-hidden="true"] {
		transform: translateY(-110%);
		opacity: 0;
		pointer-events: none;
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-lg);
		min-height: var(--header-height);
		padding-block: var(--space-xs);
	}

	.site-header__right {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: var(--space-md);
		min-width: 0;
	}

	.site-header__brand {
		color: var(--color-text);
		text-decoration: none;
		padding: var(--space-xs) var(--space-sm);
		border-radius: var(--radius-md);
		font-weight: 700;
		display: inline-flex;
		align-items: center;
		flex: 0 0 auto;
	}

	.site-header__brandLogo {
		display: block;
		height: clamp(2.25rem, 2.7vw, 3rem);
		max-height: calc(var(--header-height) - var(--space-sm));
		width: auto;
	}

	.site-header__brand:hover {
		color: var(--color-primary);
	}
</style>
