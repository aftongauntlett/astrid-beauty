---
import Button from './ui/Button.astro';
import { ChevronDown, ZoomIn, X } from '@lucide/astro';
import * as fs from 'node:fs';

import { getMessages, type Lang } from '../i18n';

export interface Props {
	lang: Lang;
}

type GalleryImage = {
	src: string;
	alt: string;
};

const { lang } = Astro.props;
const messages = getMessages(lang);

const toAlt = (filename: string) => {
	const base = filename.replace(/\.[^./\\]+$/, '');
	const words = base.replace(/[-_]+/g, ' ').trim();
	return words ? words.charAt(0).toUpperCase() + words.slice(1) : 'Gallery image';
};

const projectRootUrl = new URL('../../', import.meta.url);
const publicRootUrl = new URL('./public/', projectRootUrl);
const allowedExt = new Set(['.jpg', '.jpeg', '.png', '.webp', '.avif']);

const urlToFsPath = (url: URL) => decodeURIComponent(url.pathname);

const extname = (filename: string) => {
	const idx = filename.lastIndexOf('.');
	return idx === -1 ? '' : filename.slice(idx).toLowerCase();
};

const galleryDirName = (() => {
	const candidates = ['images', 'image'];
	for (const name of candidates) {
		if (fs.existsSync(urlToFsPath(new URL(`./${name}/`, publicRootUrl.href)))) return name;
	}
	return '';
})();

const galleryDirUrl = galleryDirName ? new URL(`./${galleryDirName}/`, publicRootUrl.href) : publicRootUrl;
const galleryDirPath = urlToFsPath(galleryDirUrl);
const galleryUrlPrefix = galleryDirName ? `/${galleryDirName}/` : '/';

const images: GalleryImage[] = fs
	.readdirSync(galleryDirPath)
	.filter((name: string) => allowedExt.has(extname(name)))
	.filter((name: string) => !name.toLowerCase().startsWith('favicon'))
	.sort((a: string, b: string) => a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' }))
	.map((name: string) => ({ src: `${galleryUrlPrefix}${name}`, alt: toAlt(name) }));

const initialMobileCount = 3;
const initialDesktopCount = 6;
const preloadCount = Math.min(initialDesktopCount, images.length);
const preloadedImages = images.slice(0, preloadCount);
const remainingImages = images.slice(preloadCount);
const showToggle = images.length > initialMobileCount;
const toggleMobileOnly = remainingImages.length === 0 && images.length <= initialDesktopCount;

const gridId = 'gallery-grid';
const toggleId = 'gallery-toggle';
const statusId = 'gallery-status';
const dataId = 'gallery-data';
---

<div class="gallery" data-gallery>
	<ul class="gallery__grid" id={gridId} aria-label={messages.gallery.imagesAriaLabel}>
		{preloadedImages.map((image, idx) => (
			<li
				class:list={[("gallery__item"), idx >= initialMobileCount && "gallery__item--preload"]}
				data-reveal
				data-reveal-delay={String(Math.min(260, (idx % 3) * 70 + Math.floor(idx / 3) * 40))}
			>
				<button
					type="button"
					class="gallery__thumb"
					data-gallery-trigger
					data-image-src={image.src}
					data-image-alt={image.alt}
					aria-label={`${messages.gallery.openImageLabel}: ${image.alt}`}
				>
					<div class="gallery__media">
						<img
							class="gallery__img"
							src={image.src}
							alt={image.alt}
							loading="lazy"
							decoding="async"
							width="900"
							height="1200"
						/>
						<span class="gallery__zoomIcon" aria-hidden="true">
							<ZoomIn class="gallery__zoomIconSvg" size={30} aria-hidden="true" focusable="false" />
						</span>
						<span class="gallery__captionHook" aria-hidden="true"></span>
					</div>
				</button>
			</li>
		))}
	</ul>

	<template id="gallery-zoom-icon-template">
		<span class="gallery__zoomIcon" aria-hidden="true">
			<ZoomIn class="gallery__zoomIconSvg" size={30} aria-hidden="true" focusable="false" />
		</span>
	</template>

	<dialog
		class="gallery__lightbox"
		data-gallery-lightbox
		aria-label={messages.gallery.closeExpandedImageLabel}
	>
		<div class="gallery__lightboxContent" data-gallery-lightbox-content>
			<button
				type="button"
				class="gallery__lightboxClose"
				data-gallery-lightbox-close
				aria-label={messages.gallery.closeExpandedImageLabel}
			>
				<X class="gallery__lightboxCloseIcon" size={26} aria-hidden="true" focusable="false" />
			</button>
			<img class="gallery__lightboxImage" data-gallery-lightbox-image alt="" />
		</div>
	</dialog>

	{showToggle ? (
		<div
			class:list={["gallery__actions", toggleMobileOnly && "gallery__actions--mobileOnly"]}
			data-reveal
			data-reveal-delay="80"
		>
			<Button
				id={toggleId}
				type="button"
				variant="secondary"
				class="gallery__toggle"
				aria-controls={gridId}
				aria-expanded="false"
			>
				<span class="gallery__toggleSpacer" aria-hidden="true"></span>
				<span class="gallery__toggleLabel">{messages.gallery.showMore}</span>
				<span class="gallery__toggleChevronWrap" aria-hidden="true">
					<ChevronDown class="gallery__toggleChevronIcon" size={18} aria-hidden="true" focusable="false" />
				</span>
			</Button>
			<p class="sr-only" id={statusId} aria-live="polite"></p>
			<script
				type="application/json"
				id="gallery-i18n"
				is:inline
				set:html={JSON.stringify({
					showMore: messages.gallery.showMore,
					showLess: messages.gallery.showLess,
					statusTemplate: messages.gallery.statusTemplate,
					openImageLabel: messages.gallery.openImageLabel,
				})}
			></script>
			<script
				type="application/json"
				id={dataId}
				is:inline
				set:html={JSON.stringify(remainingImages)}
			></script>
		</div>
	) : null}

	{showToggle ? (
		<script type="module" is:inline>
			const toggle = document.getElementById('gallery-toggle');
			const grid = document.getElementById('gallery-grid');
			const status = document.getElementById('gallery-status');
			const data = document.getElementById('gallery-data');
			const i18n = document.getElementById('gallery-i18n');
			if (!toggle || !grid || !data) {
				// Gallery markup not present.
			} else {
				const label = toggle.querySelector('.gallery__toggleLabel');
				const zoomIconTemplate = document.getElementById('gallery-zoom-icon-template');
				const MOBILE_INITIAL = 3;
				const safeParse = (node, fallback) => {
					if (!node) return fallback;
					try {
						return JSON.parse(node.textContent || '');
					} catch {
						return fallback;
					}
				};
				/** @type {{src: string, alt: string}[]} */
				const remaining = safeParse(data, []);
				const labels = safeParse(i18n, {});
				const showMoreLabel = labels.showMore || 'Show more';
				const showLessLabel = labels.showLess || 'Show less';
				const statusTemplate = labels.statusTemplate || 'Showing {count} images.';
				const openImageLabel = labels.openImageLabel || 'View larger image';
				/** @type {HTMLElement[]} */
				const extraItems = [];
				let expanded = false;

				const actions = toggle.closest('.gallery__actions');
				const preloadItems = Array.from(grid.querySelectorAll('.gallery__item--preload'));
				const baseItems = Array.from(grid.querySelectorAll('.gallery__item'));
				const baseCount = baseItems.length;

				const isOneColumn = () => window.matchMedia('(max-width: 35.999rem)').matches;
				const columns = () => {
					if (window.matchMedia('(min-width: 64rem)').matches) return 3;
					if (window.matchMedia('(min-width: 36rem)').matches) return 2;
					return 1;
				};
				const collapsedCount = () => (isOneColumn() ? Math.min(MOBILE_INITIAL, baseCount) : baseCount);
				const expandedCount = () => baseCount + remaining.length;

				const applyCollapsedVisibility = () => {
					if (expanded) return;
					const oneCol = isOneColumn();
					for (const item of preloadItems) {
						item.style.display = oneCol ? 'none' : '';
					}
					if (actions && remaining.length === 0) {
						actions.hidden = !oneCol;
					}
				};

				const computeDelay = (itemIndex) => {
					const cols = columns();
					const colDelay = (itemIndex % cols) * 70;
					const rowDelay = Math.floor(itemIndex / cols) * 40;
					return Math.min(260, colDelay + rowDelay);
				};

				const buildItem = (img, itemIndex) => {
					const li = document.createElement('li');
					li.className = 'gallery__item gallery__item--extra';
					li.setAttribute('data-reveal', '');
					li.setAttribute('data-reveal-delay', String(computeDelay(itemIndex)));

					const button = document.createElement('button');
					button.type = 'button';
					button.className = 'gallery__thumb';
					button.setAttribute('data-gallery-trigger', '');
					button.setAttribute('data-image-src', img.src);
					button.setAttribute('data-image-alt', img.alt);
					button.setAttribute('aria-label', `${openImageLabel}: ${img.alt}`);

					const media = document.createElement('div');
					media.className = 'gallery__media';

					const image = document.createElement('img');
					image.className = 'gallery__img';
					image.src = img.src;
					image.alt = img.alt;
					image.loading = 'lazy';
					image.decoding = 'async';
					image.width = 900;
					image.height = 1200;

					const captionHook = document.createElement('span');
					captionHook.className = 'gallery__captionHook';
					captionHook.setAttribute('aria-hidden', 'true');

					const fallbackZoomIcon = () => {
						const span = document.createElement('span');
						span.className = 'gallery__zoomIcon';
						span.setAttribute('aria-hidden', 'true');
						return span;
					};

					const zoomIcon =
						zoomIconTemplate instanceof HTMLTemplateElement
							? zoomIconTemplate.content.firstElementChild?.cloneNode(true)
							: null;
					const safeZoomIcon = zoomIcon instanceof HTMLElement ? zoomIcon : fallbackZoomIcon();

					media.append(image, safeZoomIcon, captionHook);
					button.append(media);
					li.append(button);
					return li;
				};

				const setStatus = (count) => {
					if (!status) return;
					status.textContent = statusTemplate.replace('{count}', String(count));
				};

				toggle.addEventListener('click', () => {
					expanded = !expanded;
					toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
					if (label) label.textContent = expanded ? showLessLabel : showMoreLabel;
					toggle.toggleAttribute('data-collapsed', !expanded);

					if (expanded) {
						if (actions) actions.hidden = false;
						for (const item of preloadItems) item.style.display = '';
						for (const img of remaining) {
							const itemIndex = baseCount + extraItems.length;
							const item = buildItem(img, itemIndex);
							extraItems.push(item);
							grid.append(item);
						}
						setStatus(expandedCount());
						window.dispatchEvent(new Event('scroll-reveal:refresh'));
					} else {
						for (const item of extraItems) item.remove();
						extraItems.length = 0;
						applyCollapsedVisibility();
						setStatus(collapsedCount());
					}
				});

				applyCollapsedVisibility();
				setStatus(collapsedCount());
				toggle.toggleAttribute('data-collapsed', true);

				const mq = window.matchMedia('(max-width: 35.999rem)');
				mq.addEventListener('change', () => {
					applyCollapsedVisibility();
					if (!expanded) setStatus(collapsedCount());
				});
			}
		</script>
	) : null}

	<script type="module" is:inline>
		const galleryRoot = document.querySelector('[data-gallery]');
		if (galleryRoot instanceof HTMLElement) {
			const lightbox = galleryRoot.querySelector('[data-gallery-lightbox]');
			const lightboxImage = galleryRoot.querySelector('[data-gallery-lightbox-image]');
			const lightboxCloseButton = galleryRoot.querySelector('[data-gallery-lightbox-close]');
			if (lightbox instanceof HTMLDialogElement && lightboxImage instanceof HTMLImageElement) {
				const openLightbox = (source, alt) => {
					if (typeof lightbox.showModal !== 'function') return;
					lightboxImage.src = source;
					lightboxImage.alt = alt;
					if (!lightbox.open) {
						lightbox.showModal();
					}
				};

				const closeLightbox = () => {
					if (!lightbox.open) return;
					lightbox.close();
				};

				lightbox.addEventListener('close', () => {
					lightboxImage.removeAttribute('src');
					lightboxImage.alt = '';
				});

				galleryRoot.addEventListener('click', (event) => {
					if (!(event.target instanceof Element)) return;
					const trigger = event.target.closest('[data-gallery-trigger]');
					if (!(trigger instanceof HTMLButtonElement)) return;
					const source = trigger.dataset.imageSrc;
					if (!source) return;
					const alt = trigger.dataset.imageAlt || '';
					openLightbox(source, alt);
				});

				lightbox.addEventListener('click', (event) => {
					if (event.target !== lightbox) return;
					closeLightbox();
				});

				if (lightboxCloseButton instanceof HTMLButtonElement) {
					lightboxCloseButton.addEventListener('click', (event) => {
						event.preventDefault();
						closeLightbox();
					});
				}
			}
		}
	</script>
</div>

<style is:global>
	.gallery .gallery__grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: var(--space-lg);
		grid-template-columns: 1fr;
	}

	.gallery .gallery__item {
		content-visibility: auto;
		contain-intrinsic-size: 460px 620px;
	}

	@media (max-width: 35.999rem) {
		.gallery .gallery__item--preload {
			display: none;
		}

		.gallery .gallery__actions--mobileOnly {
			display: block;
		}
	}

	@media (min-width: 36rem) {
		.gallery .gallery__actions--mobileOnly {
			display: none;
		}
	}

	@media (min-width: 36rem) {
		.gallery .gallery__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 64rem) {
		.gallery .gallery__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: var(--space-xl);
		}
	}

	.gallery .gallery__media {
		position: relative;
		display: block;
		aspect-ratio: 3 / 4;
		border-radius: var(--radius-lg);
		overflow: hidden;
		background: var(--color-surface);
		border: 1px solid color-mix(in oklab, var(--color-border) 60%, transparent);
	}

	.gallery .gallery__thumb {
		display: block;
		width: 100%;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		font: inherit;
		text-align: inherit;
		cursor: zoom-in;
	}

	.gallery .gallery__thumb:focus-visible {
		outline: 2px solid color-mix(in oklab, var(--color-primary) 52%, white);
		outline-offset: 3px;
		border-radius: var(--radius-lg);
	}

	.gallery .gallery__img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: translateZ(0) scale(1);
		backface-visibility: hidden;
		filter: saturate(1.05) contrast(1.02) brightness(1.02);
	}

	.gallery .gallery__toggle.btn {
		display: grid;
		grid-template-columns: 18px 1fr 18px;
		column-gap: 0.25rem;
		align-items: center;
		justify-items: center;
	}

	.gallery .gallery__toggleSpacer {
		width: 18px;
		height: 1px;
	}

	.gallery .gallery__toggleLabel {
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	.gallery .gallery__toggleChevronWrap {
		display: flex;
		align-items: center;
		justify-content: center;
		transform: rotate(0deg);
	}

	@media (prefers-reduced-motion: no-preference) {
		.gallery .gallery__toggleChevronWrap {
			transition: transform var(--motion-duration-fast) var(--motion-ease-standard);
		}
	}

	.gallery .gallery__toggle[aria-expanded='true'] .gallery__toggleChevronWrap {
		transform: rotate(180deg);
	}

	@media (prefers-reduced-motion: no-preference) {
		@keyframes gallery-chevron-wiggle {
			0% {
				transform: translateX(0) rotate(0deg);
			}
			35% {
				transform: translateX(1px) rotate(-12deg);
			}
			70% {
				transform: translateX(-1px) rotate(12deg);
			}
			100% {
				transform: translateX(0) rotate(0deg);
			}
		}

		.gallery .gallery__toggle:hover .gallery__toggleChevronIcon,
		.gallery .gallery__toggle:focus-visible .gallery__toggleChevronIcon {
			transform-origin: 50% 50%;
			animation: gallery-chevron-wiggle 0.55s ease-in-out;
		}
	}

	.gallery .gallery__media::before {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			linear-gradient(
				180deg,
				color-mix(in oklab, var(--color-shadow) 10%, transparent),
				transparent 52%
			),
			linear-gradient(
				0deg,
				color-mix(in oklab, var(--color-shadow) 12%, transparent),
				transparent 62%
			);
		opacity: 0.08;
	}

	.gallery .gallery__zoomIcon {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		width: 3.15rem;
		height: 3.15rem;
		display: grid;
		place-items: center;
		border-radius: 999px;
		background: color-mix(in oklab, var(--color-surface) 70%, var(--color-shadow));
		color: var(--color-text);
		pointer-events: none;
		opacity: 0;
		transform: translateY(2px) scale(0.94);
		line-height: 0;
	}

	.gallery .gallery__zoomIconSvg {
		display: block;
		width: 1.72rem;
		height: 1.72rem;
	}

	.gallery .gallery__media::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(
			120deg,
			transparent 0%,
			color-mix(in oklab, var(--color-secondary) 18%, transparent) 34%,
			color-mix(in oklab, var(--color-surface) 40%, transparent) 44%,
			transparent 60%
		);
		transform: translateX(-130%) skewX(-15deg);
		opacity: 0;
	}

	@media (prefers-reduced-motion: no-preference) {
		.gallery .gallery__media {
			transition:
				box-shadow var(--motion-duration-fast) var(--motion-ease-standard),
				border-color var(--motion-duration-fast) var(--motion-ease-standard),
				transform var(--motion-duration-fast) var(--motion-ease-standard);
		}

		.gallery .gallery__zoomIcon {
			transition:
				opacity var(--motion-duration-fast) var(--motion-ease-standard),
				transform var(--motion-duration-fast) var(--motion-ease-standard);
		}

		.gallery .gallery__img {
			transition:
				transform var(--motion-duration-slow) var(--motion-ease-standard),
				filter var(--motion-duration-normal) var(--motion-ease-standard);
		}

		.gallery .gallery__media::after {
			transition:
				transform 520ms var(--motion-ease-standard),
				opacity var(--motion-duration-normal) var(--motion-ease-standard);
		}

		.gallery .gallery__item:hover .gallery__media,
		.gallery .gallery__item:focus-within .gallery__media {
			transform: translateY(-2px);
			box-shadow: var(--shadow-md);
			border-color: color-mix(in oklab, var(--color-primary) 22%, var(--color-border));
		}

		.gallery .gallery__item:hover .gallery__media::after,
		.gallery .gallery__item:focus-within .gallery__media::after {
			opacity: 1;
			transform: translateX(130%) skewX(-15deg);
		}

		.gallery .gallery__item:hover .gallery__img,
		.gallery .gallery__item:focus-within .gallery__img {
			transform: translateZ(0) scale(1.015);
			filter: saturate(1) contrast(0.98) brightness(1);
		}

		.gallery .gallery__item:hover .gallery__zoomIcon,
		.gallery .gallery__item:focus-within .gallery__zoomIcon {
			opacity: 0.74;
			transform: translateY(0) scale(1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.gallery .gallery__media::after {
			opacity: 0 !important;
			transform: none !important;
		}

		.gallery .gallery__img {
			transform: none !important;
		}
	}

	@media (hover: none), (pointer: coarse), (max-width: 48rem) {
		.gallery .gallery__thumb {
			cursor: default;
		}

		.gallery .gallery__zoomIcon {
			opacity: 0.74;
			transform: translateY(0) scale(1);
		}
	}

	.gallery .gallery__actions {
		display: flex;
		justify-content: center;
		margin-top: var(--space-lg);
	}

	.gallery .gallery__actions .btn {
		width: fit-content;
		max-width: 100%;
	}

	.gallery .gallery__captionHook {
		position: absolute;
		inset: auto 0 0 0;
		min-height: 2.25rem;
		pointer-events: none;
	}

	.gallery .gallery__lightbox {
		position: fixed;
		inset: 0;
		margin: 0;
		width: 100dvw;
		height: 100dvh;
		display: grid;
		place-items: center;
		padding: var(--space-md);
		border: 0;
		max-width: none;
		max-height: none;
		background: transparent;
		overflow: hidden;
		cursor: default;
		z-index: 60;
	}

	.gallery .gallery__lightbox:not([open]) {
		display: none;
	}

	.gallery .gallery__lightbox::backdrop {
		background: color-mix(in oklab, var(--color-shadow) 76%, transparent);
		backdrop-filter: blur(1px);
		cursor: zoom-out;
	}

	.gallery .gallery__lightboxImage {
		display: block;
		max-width: min(96vw, 78rem);
		max-height: 92vh;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-lg);
		background: var(--color-surface);
		object-fit: contain;
	}

	.gallery .gallery__lightboxContent {
		position: relative;
		display: grid;
		place-items: center;
	}

	.gallery .gallery__lightboxClose {
		position: absolute;
		top: var(--space-sm);
		right: var(--space-sm);
		width: 3rem;
		height: 3rem;
		display: inline-grid;
		place-items: center;
		border: 1px solid color-mix(in oklab, var(--color-border) 70%, transparent);
		border-radius: 999px;
		background: color-mix(in oklab, var(--color-surface) 74%, var(--color-shadow));
		color: var(--color-text);
		cursor: pointer;
		z-index: 1;
	}

	.gallery .gallery__lightboxCloseIcon {
		display: block;
		width: 1.62rem;
		height: 1.62rem;
	}

	html:not([data-theme="dark"]) .gallery .gallery__lightboxClose {
		background: color-mix(in oklab, var(--color-surface-elevated) 95%, var(--color-secondary) 5%);
		color: color-mix(in oklab, var(--color-text) 82%, var(--color-primary));
		border-color: color-mix(in oklab, var(--color-border) 84%, transparent);
		box-shadow:
			var(--shadow-sm),
			inset 0 1px 0 color-mix(in oklab, white 72%, transparent);
	}

	.gallery .gallery__lightboxClose:focus-visible {
		outline: 2px solid color-mix(in oklab, var(--color-primary) 52%, white);
		outline-offset: 2px;
	}

	@media (prefers-reduced-motion: no-preference) {
		.gallery .gallery__lightboxClose {
			transition:
