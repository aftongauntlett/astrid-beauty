---
import Button from './ui/Button.astro';
import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

type GalleryImage = {
	src: string;
	alt: string;
};

const toAlt = (filename: string) => {
	const base = filename.replace(/\.[^./\\]+$/, '');
	const words = base.replace(/[-_]+/g, ' ').trim();
	return words ? words.charAt(0).toUpperCase() + words.slice(1) : 'Gallery image';
};

const projectRootUrl = new URL('../../', import.meta.url);
const publicRootPath = fileURLToPath(new URL('./public/', projectRootUrl));
const allowedExt = new Set(['.jpg', '.jpeg', '.png', '.webp', '.avif']);

const galleryDirName = (() => {
	const candidates = ['images', 'image'];
	for (const name of candidates) {
		if (fs.existsSync(path.join(publicRootPath, name))) return name;
	}
	return '';
})();

const galleryDirPath = galleryDirName ? path.join(publicRootPath, galleryDirName) : publicRootPath;
const galleryUrlPrefix = galleryDirName ? `/${galleryDirName}/` : '/';

const images: GalleryImage[] = fs
	.readdirSync(galleryDirPath)
	.filter((name: string) => allowedExt.has(path.extname(name).toLowerCase()))
	.filter((name: string) => !name.toLowerCase().startsWith('favicon'))
	.sort((a: string, b: string) => a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' }))
	.map((name: string) => ({ src: `${galleryUrlPrefix}${name}`, alt: toAlt(name) }));

const initialCount = 8;
const initialImages = images.slice(0, initialCount);
const remainingImages = images.slice(initialCount);

const gridId = 'gallery-grid';
const toggleId = 'gallery-toggle';
const statusId = 'gallery-status';
const dataId = 'gallery-data';
---

<div class="gallery" data-gallery>
	<ul class="gallery__grid" id={gridId} aria-label="Gallery images">
		{initialImages.map((image) => (
			<li class="gallery__item">
				<div class="gallery__card">
					<img
						class="gallery__img"
						src={image.src}
						alt={image.alt}
						loading="lazy"
						decoding="async"
						width="900"
						height="1200"
					/>
				</div>
			</li>
		))}
	</ul>

	{remainingImages.length ? (
		<div class="gallery__actions">
			<Button
				id={toggleId}
				type="button"
				variant="secondary"
				aria-controls={gridId}
				aria-expanded="false"
			>
				Show more
			</Button>
			<p class="sr-only" id={statusId} aria-live="polite"></p>
			<script
				type="application/json"
				id={dataId}
				is:inline
				set:html={JSON.stringify(remainingImages)}
			></script>
		</div>
	) : null}

	{remainingImages.length ? (
		<script type="module" is:inline>
			const toggle = document.getElementById('gallery-toggle');
			const grid = document.getElementById('gallery-grid');
			const status = document.getElementById('gallery-status');
			const data = document.getElementById('gallery-data');
			if (!toggle || !grid || !data) {
				// Gallery markup not present.
			} else {
				const initialCount = 8;
				/** @type {{src: string, alt: string}[]} */
				const remaining = JSON.parse(data.textContent || '[]');
				/** @type {HTMLElement[]} */
				const extraItems = [];
				let expanded = false;

				const buildItem = (img) => {
					const li = document.createElement('li');
					li.className = 'gallery__item gallery__item--extra';

					const card = document.createElement('div');
					card.className = 'gallery__card';

					const image = document.createElement('img');
					image.className = 'gallery__img';
					image.src = img.src;
					image.alt = img.alt;
					image.loading = 'lazy';
					image.decoding = 'async';
					image.width = 900;
					image.height = 1200;

					card.append(image);
					li.append(card);
					return li;
				};

				const setStatus = (count) => {
					if (!status) return;
					status.textContent = `Showing ${count} images.`;
				};

				toggle.addEventListener('click', () => {
					expanded = !expanded;
					toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
					toggle.textContent = expanded ? 'Show less' : 'Show more';

					if (expanded) {
						for (const img of remaining) {
							const item = buildItem(img);
							extraItems.push(item);
							grid.append(item);
						}
						setStatus(initialCount + remaining.length);
					} else {
						for (const item of extraItems) item.remove();
						extraItems.length = 0;
						setStatus(initialCount);
					}
				});

				setStatus(initialCount);
			}
		</script>
	) : null}
</div>

<style is:global>
	.gallery .gallery__grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: var(--space-md);
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	@media (min-width: 48rem) {
		.gallery .gallery__grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	.gallery .gallery__card {
		position: relative;
		display: block;
		aspect-ratio: 3 / 4;
		border-radius: var(--radius-lg);
		overflow: hidden;
		background: var(--color-surface);
		border: 1px solid color-mix(in oklab, var(--color-border) 70%, transparent);
		box-shadow: var(--shadow-sm);
	}

	.gallery .gallery__img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: translateZ(0) scale(1);
		backface-visibility: hidden;
		filter: saturate(1.02) contrast(0.98);
	}

	.gallery .gallery__card::before {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			linear-gradient(180deg, color-mix(in oklab, black 6%, transparent), transparent 50%),
			linear-gradient(0deg, color-mix(in oklab, black 8%, transparent), transparent 60%);
		opacity: 0.28;
	}

	.gallery .gallery__card::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(
			120deg,
			transparent 0%,
			color-mix(in oklab, white 30%, transparent) 35%,
			color-mix(in oklab, white 55%, transparent) 45%,
			transparent 60%
		);
		transform: translateX(-130%) skewX(-15deg);
		opacity: 0;
	}

	.gallery .gallery__card:hover {
		box-shadow: var(--shadow-md);
		border-color: color-mix(in oklab, var(--color-primary) 35%, var(--color-border));
	}

	@media (prefers-reduced-motion: no-preference) {
		.gallery .gallery__card {
			transition:
				box-shadow 180ms ease,
				transform 180ms ease,
				border-color 180ms ease;
		}

		.gallery .gallery__img {
			will-change: transform;
			transition:
				transform 300ms ease,
				filter 240ms ease;
		}

		.gallery .gallery__card::after {
			transition:
				transform 520ms ease,
				opacity 240ms ease;
		}

		.gallery .gallery__card:hover::after {
			opacity: 1;
			transform: translateX(130%) skewX(-15deg);
		}

		.gallery .gallery__card:hover .gallery__img {
			transform: translateZ(0) scale(1.02);
			filter: saturate(1.04) contrast(0.99);
		}
	}

	.gallery .gallery__actions {
		display: flex;
		justify-content: center;
		margin-top: calc(var(--space-xl) + var(--space-lg));
	}
</style>
