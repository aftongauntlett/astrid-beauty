---
import FeatureIconCardReact from "./FeatureIconCard";

export interface Props {
	title: string;
	items?: string[];
	description?: string;
	iconName?: "sparkles" | "shield";
	iconColor?: string;
}

const { title, items, description, iconName, iconColor } = Astro.props as Props;

const reactProps = {
	title,
	...(iconName ? { iconName } : {}),
	...(items ? { items } : {}),
	...(description ? { description } : {}),
	...(iconColor ? { iconColor } : {}),
};
---

<FeatureIconCardReact
	client:visible
	{...reactProps}
/>